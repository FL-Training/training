---
/**
 * Rendu d'une porte de la rubrique « Formations » : entête, cartes
 * dépliables (une seule ouverte à la fois), encart PAXI éventuel,
 * sections éditoriales, appel à l'action.
 *
 * Extrait de la route pour que celle-ci puisse aussi servir les
 * redirections des anciennes fiches.
 */
import type { CollectionEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import Picto from "./Picto.astro";
import SignatureCarte from "./SignatureCarte.astro";
import { href } from "../lib/url";
import { contenuLangue } from "../lib/contenu";
import { langueActive } from "../lib/langue-active";
import { cheminLangue, lienContenu } from "../lib/routes";

// La langue se lit dans l'adresse : ce composant sert toutes les
// langues publiées, le contenu suit.
const langue = langueActive(Astro.url.pathname);
const { formationsPage } = contenuLangue(langue);
import { enrichir } from "../lib/texte";

interface Props {
  entry: CollectionEntry<"portes">;
}

const { entry } = Astro.props;
const {
  nom,
  statut,
  picto,
  seo,
  entete,
  visuel,
  signature,
  intro,
  cartes,
  encart_paxi,
  sections,
  encarts,
  cta,
} = entry.data;
const { carte, porte: libelles } = formationsPage;
---

<Base
  title={seo.titre}
  description={seo.description}
  fil={[
    { label: "Formations", chemin: cheminLangue(langue, "/formations") },
    { label: nom, chemin: `${cheminLangue(langue, "/formations")}/${entry.data.chemin ?? entry.id}` },
  ]}
>
  <section class="porte-section mx-auto max-w-6xl px-6 pt-16 pb-20 md:pt-24">
    {/*
      L'entête est un bloc positionné : la photographie de la porte s'y
      loge à droite, derrière le texte. Elle reprend l'image de la carte
      du carrefour « Formations » — le visiteur retrouve l'ambiance sur
      laquelle il a cliqué.

      Réservée au grand écran : sous 768 px, il n'y a pas de colonne
      libre et elle passerait derrière le titre au lieu de l'équilibrer.
      Aucun effet au survol — c'est un fond, pas un élément à activer.
    */}
    <div class="entete-porte relative">
      {
        visuel && (
          <div class="entete-visuel" aria-hidden="true">
            <img
              src={href(visuel.src)}
              alt=""
              width="1000"
              height="1000"
              loading="eager"
              decoding="async"
            />
          </div>
        )
      }

      <div class="relative">
        <a
          href={href(cheminLangue(langue, "/formations"))}
          class="inline-flex items-center gap-2 text-sm font-semibold text-sage-deep hover:text-navy-deep"
        >
          <span aria-hidden="true">←</span>
          {libelles.retour}
        </a>

        <div class="mt-8 flex items-center gap-3">
          <Picto nom={picto} />
          <p class="eyebrow">{entete.surtitre}</p>
        </div>
        <h1 class="display mt-4 max-w-3xl text-4xl text-navy-deep md:text-5xl">
          {entete.titre}
        </h1>
        <p
          class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft"
          set:html={enrichir(entete.texte)}
        />

        {
          statut === "stub" && (
            <p class="mt-6 inline-block rounded-full bg-paper-deep/60 px-4 py-1.5 text-[0.7rem] font-semibold tracking-wide text-ink-faint uppercase">
              {carte.badge_stub}
            </p>
          )
        }

        {
          entete.bouton && (
            <div>
              <a href={href(cheminLangue(langue, "/contact"))} class="btn btn-primary mt-8">
                {entete.bouton} <span aria-hidden="true">→</span>
              </a>
            </div>
          )
        }
      </div>
    </div>

    {
      signature && (
        <SignatureCarte forme={signature} class="signature-page" data-reveal />
      )
    }

    {
      intro && (
        <div class="mt-12 max-w-3xl space-y-4 border-l-2 border-sage/50 pl-6 leading-relaxed text-ink-soft">
          {intro.split("\n\n").map((p) => (
            <p set:html={enrichir(p)} />
          ))}
        </div>
      )
    }

    {/*
      Accordéon natif : l'attribut `name` partagé ne laisse qu'une seule
      carte ouverte à la fois, sans JavaScript et sans piège clavier.
      L'ouverture au survol sur ordinateur et la compensation du
      déplacement de page sont ajoutées par cartes-depliables.ts, en
      complément du clic — jamais à sa place.
    */}
    {
      cartes.length > 0 && (
        <div class="mt-14 grid gap-4" data-reveal-group data-reveal-stagger="60">
          {cartes.map((c) =>
            // Une carte sans contenu déplié ne doit pas afficher de
            // chevron : le visiteur cliquerait sur une promesse vide.
            c.paragraphes.length === 0 &&
            !c.resultat &&
            !c.publics &&
            !c.bouton &&
            !c.visuel ? (
              <div class="carte-depliable carte-statique" data-reveal>
                <div class="carte-entete">
                  <span class="display block text-xl leading-snug text-navy-deep md:text-[1.4rem]">
                    {c.titre}
                  </span>
                  {c.sous_titre && (
                    <span class="mt-1.5 block text-[0.95rem] leading-snug text-ink-faint">
                      {c.sous_titre}
                    </span>
                  )}
                  {/*
                    L'état de l'offre, annoncé avant son contenu : le
                    livrable transitoire demande qu'il soit clairement
                    identifiable. Pastille sauge, la même que le badge
                    des portes en préparation sur le carrefour.
                  */}
                  {c.statut_carte && (
                    <span class="statut-carte">{c.statut_carte}</span>
                  )}
                  <span class="mt-3 block leading-relaxed text-ink-soft">
                    {c.resume}
                  </span>
                </div>
              </div>
            ) : (
            <details name={`porte-${entry.id}`} class="carte-depliable" data-reveal>
              <summary>
                {/*
                  Le contour se dessine autour de la carte à l'ouverture,
                  puis reste comme marque de l'état actif. Il vit DANS le
                  summary : c'est la seule partie d'un <details> qui reste
                  rendue quand la carte est fermée, donc la seule depuis
                  laquelle une transition peut démarrer.
                */}
                <svg class="carte-contour" aria-hidden="true" focusable="false">
                  <rect pathLength="1" />
                </svg>
                <span class="flex-1">
                  <span class="display block text-xl leading-snug text-navy-deep md:text-[1.4rem]">
                    {c.titre}
                  </span>
                  {c.sous_titre && (
                    <span class="mt-1.5 block text-[0.95rem] leading-snug text-ink-faint">
                      {c.sous_titre}
                    </span>
                  )}
                  {c.statut_carte && (
                    <span class="statut-carte">{c.statut_carte}</span>
                  )}
                  <span class="mt-2 block leading-relaxed text-ink-soft">
                    {c.resume}
                  </span>
                </span>
                <span class="carte-chevron" aria-hidden="true">
                  <svg viewBox="0 0 20 20" fill="none" class="h-5 w-5">
                    <path
                      d="M5 8l5 5 5-5"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </summary>

              <div class="carte-contenu">
                {c.signature && (
                  <SignatureCarte forme={c.signature} class="carte-signature" />
                )}

                <div class="carte-corps">
                  {/*
                    Réservé aux vraies photos, le jour où Fabien en aura :
                    aucune carte n'en porte aujourd'hui.
                  */}
                  {c.visuel && (
                    <figure class="carte-figure">
                      <img
                        src={href(c.visuel.src)}
                        alt={c.visuel.alt}
                        loading="lazy"
                        class:list={[
                          "carte-visuel",
                          // La variante claire ne s'efface en thème
                          // sombre que si une variante sombre existe
                          // pour la remplacer — sinon mieux vaut
                          // l'afficher telle quelle que rien du tout.
                          c.visuel.src_sombre && "carte-visuel-clair",
                        ]}
                      />
                      {c.visuel.src_sombre && (
                        <img
                          src={href(c.visuel.src_sombre)}
                          alt={c.visuel.alt}
                          loading="lazy"
                          class="carte-visuel carte-visuel-sombre"
                        />
                      )}
                    </figure>
                  )}

                  {c.paragraphes.map((p) => (
                    <p class="leading-relaxed text-ink-soft" set:html={enrichir(p)} />
                  ))}

                  {c.resultat && (
                    <p class="rounded-xl bg-sage-faint px-5 py-4 leading-relaxed text-sage-deep">
                      {c.resultat}
                    </p>
                  )}

                  {c.publics && (
                    <div class="border-t border-ink/10 pt-4">
                      <p class="text-[0.7rem] font-semibold tracking-wide text-ink-faint uppercase">
                        {libelles.libelle_publics}
                      </p>
                      <p class="mt-2 leading-relaxed text-ink-soft">{c.publics}</p>
                    </div>
                  )}

                  {c.bouton && (
                    <a
                      href={href(lienContenu(langue, c.bouton.chemin))}
                      class="btn btn-primary self-start"
                    >
                      {c.bouton.label} <span aria-hidden="true">→</span>
                    </a>
                  )}
                </div>
              </div>
            </details>
            ),
          )}
        </div>
      )
    }

    {
      encart_paxi && (
        <a
          href={href(cheminLangue(langue, "/formations/paxi"))}
          class="encart-paxi group relative mt-14 flex flex-col gap-5 overflow-hidden rounded-2xl bg-abysse p-8 text-paper shadow-(--shadow-card) transition-transform duration-300 hover:-translate-y-0.5 md:flex-row md:items-center md:justify-between"
          data-reveal
        >
          {/*
            Une cabine d'avion, fondue dans le bleu de l'encart : elle
            situe PAXI d'un coup d'œil, avant même la lecture. Fondue
            vers le fond et non vers le papier — c'est le seul bloc
            sombre du site à porter une photographie.
          */}
          <span class="encart-paxi-visuel" aria-hidden="true">
            <img
              src={href("/formations/paxi.webp")}
              alt=""
              width="1000"
              height="1000"
              loading="lazy"
              decoding="async"
            />
          </span>

          <div class="relative">
            <p class="eyebrow !text-sage">{libelles.encart_paxi_surtitre}</p>
            <h2 class="display mt-2 text-2xl">{libelles.encart_paxi_titre}</h2>
            <div class="mt-3 max-w-2xl space-y-2 text-[0.95rem] leading-relaxed text-paper/75">
              {encart_paxi.paragraphes.map((p) => (
                <p>{p}</p>
              ))}
            </div>
          </div>
          <span class="btn relative shrink-0 self-start border-1.5 border-sage bg-sage !px-6 text-abysse group-hover:border-paper group-hover:bg-paper md:self-center">
            {encart_paxi.bouton} <span aria-hidden="true">→</span>
          </span>
        </a>
      )
    }

    {
      sections.map((s) => (
        <div class="mt-16 max-w-3xl" data-reveal-group>
          <h2 class="display text-2xl text-navy-deep md:text-3xl" data-reveal>
            {s.titre}
          </h2>
          <div class="mt-5 space-y-4">
            {s.paragraphes.map((p) => (
              <p
                class="leading-relaxed text-ink-soft"
                data-reveal
                set:html={enrichir(p)}
              />
            ))}
          </div>
        </div>
      ))
    }

    {/*
      Encarts transversaux. Traités comme des blocs distincts du fil de
      lecture — fond et filet propres — mais sans la présence d'une
      section : ils valent pour toute la page et ne doivent jamais se
      lire comme un axe ou une offre de plus.
    */}
    {
      encarts.length > 0 && (
        <div class="mt-16 grid max-w-4xl gap-6" data-reveal-group>
          {encarts.map((e) => (
            <aside
              class="rounded-2xl border border-sage/30 bg-sage-faint/50 p-8"
              data-reveal
            >
              <h2 class="display text-xl text-navy-deep md:text-2xl">
                {e.titre}
              </h2>
              <div class="mt-4 space-y-3">
                {e.paragraphes.map((p) => (
                  <p
                    class="leading-relaxed text-ink-soft"
                    set:html={enrichir(p)}
                  />
                ))}
              </div>
              {e.lien && (
                <a
                  href={href(lienContenu(langue, e.lien.chemin))}
                  class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-sage-deep hover:text-navy-deep"
                >
                  {e.lien.label}
                  <span aria-hidden="true">→</span>
                </a>
              )}
            </aside>
          ))}
        </div>
      )
    }

    {/*
      Charte : bord gauche dominant, pas de centrages répétés hors
      couverture. Le bouton part à droite sur grand écran pour équilibrer
      le bloc sans recourir au centrage.

      Tout le bloc est conditionnel : une porte dont le livrable ne
      prévoit aucun appel à l'échange — « En individuel » pendant la
      période transitoire — se termine sur sa dernière carte.
    */}
    {cta && (
    <div
      class:list={[
        "mt-20 flex flex-col gap-6 rounded-2xl border border-ink/10 bg-paper-deep/40 p-10",
        // Sans accroche, le bloc se réduit au geste : inutile de le
        // pousser sur toute la largeur.
        cta.titre || cta.texte
          ? "md:flex-row md:items-center md:justify-between"
          : "items-start",
      ]}
    >
      {
        (cta.titre || cta.texte) && (
          <div>
            {cta.titre && (
              <h2 class="display max-w-xl text-2xl text-navy-deep md:text-3xl">
                {cta.titre}
              </h2>
            )}
            {cta.texte && <p class="mt-3 max-w-xl text-ink-soft">{cta.texte}</p>}
          </div>
        )
      }
      <a
        href={href(cheminLangue(langue, "/contact"))}
        class:list={[
          "btn btn-primary shrink-0 self-start",
          // Le bouton ne se recentre que s'il fait face à une accroche.
          // Seul, il reste au bord gauche, comme le veut la charte.
          (cta.titre || cta.texte) && "md:self-center",
        ]}
      >
        {cta.bouton} <span aria-hidden="true">→</span>
      </a>
    </div>
    )}
  </section>
</Base>

<style>
  /*
    LA CABINE, DANS L'ENCART PAXI

    Seul bloc sombre du site à porter une photographie : le fondu ne va
    donc pas vers le papier mais vers le bleu abysse. L'image est très
    en retrait — une profondeur derrière le texte plutôt qu'une
    illustration — et son masque la laisse disparaître avant d'atteindre
    la colonne de lecture.

    Le mélange en `luminosity` ne conserve que ses valeurs et lui prend
    sa couleur au fond : la cabine se teinte du bleu de l'encart au lieu
    d'y flotter comme une vignette rapportée.
  */
  .encart-paxi-visuel {
    position: absolute;
    inset: 0 0 0 auto;
    width: 64%;
    pointer-events: none;
  }

  .encart-paxi-visuel img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Relevée : à 0,3 la cabine se devinait à peine. Elle doit se
       reconnaître d'un coup d'œil tout en restant un fond. */
    opacity: 0.55;
    mix-blend-mode: luminosity;
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgb(0 0 0 / 0.35) 26%,
      #000 66%,
      #000 100%
    );
  }

  /* Sous 768 px, l'encart passe en colonne : la photo se retrouverait
     derrière le texte sur toute sa largeur. */
  @media (max-width: 767px) {
    .encart-paxi-visuel {
      display: none;
    }
  }

  /*
    LA PHOTOGRAPHIE D'ENTÊTE

    Même parti pris que sur les cartes du carrefour : l'image n'a pas de
    bord, elle se dissout dans le papier. Le masque est ici dissymétrique
    — franc à gauche, où le texte passe devant, plus doux à droite. Elle
    accompagne la colonne de lecture sans jamais la disputer.

    Pas de survol : ce fond n'est pas un élément interactif.
  */
  .entete-visuel {
    position: absolute;
    top: 50%;
    right: -1rem;
    width: 46%;
    /* Un peu plus haute que le texte : ses bords fondus doivent sortir
       du bloc, sinon on devine une bande. */
    height: 116%;
    transform: translateY(-50%);
    pointer-events: none;
    /* Sous le texte en toutes circonstances. */
    z-index: 0;
  }

  .entete-visuel img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.4;
    filter: saturate(0.6) contrast(0.95);
    mask-image:
      linear-gradient(
        to right,
        transparent 0%,
        rgb(0 0 0 / 0.25) 26%,
        #000 62%,
        rgb(0 0 0 / 0.6) 92%,
        transparent 100%
      ),
      linear-gradient(
        to bottom,
        transparent 0%,
        #000 26%,
        #000 72%,
        transparent 100%
      );
    mask-composite: intersect;
    -webkit-mask-composite: source-in;
  }

  /* Sous 768 px, aucune colonne libre : l'image passerait derrière le
     titre au lieu de l'équilibrer. */
  @media (max-width: 767px) {
    .entete-visuel {
      display: none;
    }
  }

  /* `clip` et non `hidden` : ne crée pas de conteneur de défilement,
     donc l'en-tête collant du site continue de fonctionner. */
  .porte-section {
    overflow-x: clip;
  }

  .carte-depliable {
    position: relative;
    border: 1px solid color-mix(in oklab, var(--color-ink) 12%, transparent);
    border-radius: 1rem;
    background: color-mix(in oklab, var(--color-paper) 92%, white);
    transition: border-color var(--dur-moyen, 0.3s) ease;
  }

  .carte-depliable:hover {
    border-color: color-mix(in oklab, var(--color-sage-deep) 30%, transparent);
  }

  /*
    Le contour tracé. Il se superpose exactement à la bordure : les
    propriétés géométriques du rect sont pilotées en CSS, donc il suit
    la carte quelle que soit sa taille, sans viewBox ni mesure.
  */
  .carte-contour {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: 1;
  }

  .carte-contour rect {
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    rx: 1rem;
    fill: none;
    stroke: var(--color-sage-deep);
    stroke-width: 1.5;
    /* Fermé : le trait est entièrement escamoté. */
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0.75;
    /* Courbe presque régulière : une ease-out marquée escamote le
       début du tracé et donne l'impression que tout arrive d'un coup.
       Ici le trait se voit courir sur tout son parcours. */
    transition: stroke-dashoffset 1000ms cubic-bezier(0.45, 0.05, 0.3, 1);
  }

  /* Ouvert : le trait fait le tour, en partant du coin supérieur droit
     et dans le sens horaire — il « descend » du côté du chevron, là où
     le clic vient d'avoir lieu. */
  .carte-depliable[open] .carte-contour rect {
    stroke-dashoffset: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .carte-contour rect {
      transition: none;
    }
  }

  /*
    Le statut d'une offre annoncée mais pas encore ouverte.

    Pastille discrète, dans le vert de la marque : assez présente pour
    être lue avant le texte, assez sobre pour ne pas ressembler à une
    étiquette promotionnelle. Le livrable exige qu'elle soit clairement
    identifiable — c'est le seul élément de la carte qui porte une
    couleur de fond.
  */
  .statut-carte {
    display: inline-block;
    margin-top: 0.85rem;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: var(--color-sage-faint);
    color: var(--color-sage-deep);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .carte-depliable summary,
  .carte-entete {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 1.75rem;
    list-style: none;
  }

  .carte-depliable summary {
    cursor: pointer;
  }

  /* Carte sans contenu à déplier : pas de survol actif, pas de chevron. */
  .carte-statique:hover {
    border-color: color-mix(in oklab, var(--color-ink) 12%, transparent);
  }

  .carte-entete {
    flex-direction: column;
    gap: 0;
  }

  .carte-depliable summary::-webkit-details-marker {
    display: none;
  }

  /*
    Ouverture orchestrée, en trois temps qui se recouvrent :
      1. la carte se déplie en hauteur (::details-content) ;
      2. les blocs de texte montent en cascade ;
      3. la signature se trace (dans SignatureCarte.astro).

    Rien n'est mesuré en JavaScript : `interpolate-size` permet
    d'animer vers `auto`, et `allow-discrete` fait patienter la
    bascule de visibilité jusqu'à la fin. Sur un navigateur qui ne
    connaît pas ces propriétés, la carte s'ouvre instantanément et
    reste parfaitement utilisable.
  */
  .carte-depliable::details-content {
    block-size: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      block-size 520ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 300ms ease,
      content-visibility 520ms allow-discrete;
  }

  .carte-depliable[open]::details-content {
    block-size: auto;
    opacity: 1;
  }

  /* La cascade : chaque bloc suit le précédent d'un souffle. */
  .carte-depliable[open] .carte-corps > * {
    animation: carte-monter 560ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
    animation-delay: calc(var(--rang, 0) * 60ms + 140ms);
  }

  .carte-corps > *:nth-child(1) {
    --rang: 0;
  }
  .carte-corps > *:nth-child(2) {
    --rang: 1;
  }
  .carte-corps > *:nth-child(3) {
    --rang: 2;
  }
  .carte-corps > *:nth-child(4) {
    --rang: 3;
  }
  .carte-corps > *:nth-child(5) {
    --rang: 4;
  }
  .carte-corps > *:nth-child(n + 6) {
    --rang: 5;
  }

  @keyframes carte-monter {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carte-depliable::details-content {
