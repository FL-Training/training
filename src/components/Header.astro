---
/**
 * Menu principal — version A de l'architecture V2 : les sept entrées du
 * schéma de Fabien, à plat, dans l'ordre du document.
 *
 * Contrainte de place : sept entrées textuelles réclament ~715 px à
 * côté du logo. Deux décisions leur font de la place — le slogan a été
 * retiré de la marque (26/07) et « Le Journal Pacivis » est raccourci
 * en « Le Journal » dans le menu comme dans le pied de page, la
 * rubrique gardant son nom complet en tête de sa propre page. En
 * dessous de 1024 px, bouton hamburger.
 *
 * Si la densité gêne encore, les leviers restants sont : rendre
 * « Accueil » implicite via le logo, ou revenir à un menu à quatre
 * entrées plus deux boutons d'action.
 */
import { href } from "../lib/url";
import { contenuLangue } from "../lib/contenu";
import { langueActive } from "../lib/langue-active";
import { cheminLangue, correspondanceRoute, lienContenu } from "../lib/routes";
import { LANGUES, LANGUE_PAR_DEFAUT } from "../lib/langues";

// La langue se lit dans l'adresse : ce composant sert toutes les
// langues publiées, le contenu suit.
const langue = langueActive(Astro.url.pathname);
const { commun } = contenuLangue(langue);

/*
  Le sélecteur de langue : n'existe qu'à partir de deux langues
  publiées. Chaque langue mène à la page jumelle quand la table des
  routes la connaît, à son accueil sinon (entrées de collections — leurs
  jumelles exactes viendront avec l'étape SEO).
*/
const autresLangues = (() => {
  const publiees = LANGUES.filter((l) => l.publiee);
  if (publiees.length < 2) return [];
  const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
  let chemin = Astro.url.pathname.startsWith(base)
    ? Astro.url.pathname.slice(base.length)
    : Astro.url.pathname;
  if (langue !== LANGUE_PAR_DEFAUT) chemin = chemin.slice(langue.length + 1) || "/";
  const r = correspondanceRoute(langue, chemin);
  return publiees
    .filter((l) => l.code !== langue)
    .map((l) => {
      const cheminCible = r
        ? (r.chemins as Record<string, string>)[l.code]
        : "/";
      const prefixe = l.code === LANGUE_PAR_DEFAUT ? "" : `/${l.code}`;
      return {
        code: l.code,
        nom: l.nom,
        href: href(`${prefixe}${cheminCible === "/" && prefixe ? "/" : cheminCible}`),
      };
    });
})();
import Picto from "./Picto.astro";

/**
 * Isole le mot ARCA dans un libellé de raccourci.
 *
 * La page « Notre approche » fait vivre ce mot : ses quatre lettres
 * s'illuminent une à une, chacune parcourue d'une étincelle, à mesure
 * que le pilier correspondant se dévoile. Le menu reprend l'écho de ce
 * geste — les capitales espacées, la teinte verte, et la même lueur au
 * survol. Le lien et sa destination parlent ainsi la même langue, sans
 * que le visiteur ait à le remarquer.
 *
 * Découpage tolérant : un libellé sans le mot traverse la fonction sans
 * rien changer.
 */
function decouperArca(
  label: string,
): { avant: string; apres: string } | null {
  const i = label.indexOf("ARCA");
  if (i === -1) return null;
  return { avant: label.slice(0, i), apres: label.slice(i + 4) };
}

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const current = Astro.url.pathname.replace(base, "").replace(/\/+$/, "") || "/";

function isCurrent(path: string): boolean {
  if (path === "/") return current === "/";
  return current === path || current.startsWith(`${path}/`);
}
---

<header
  transition:animate="none"
  class="sticky top-0 z-40 border-b border-ink/10 bg-paper/85 backdrop-blur-md"
>
  <span class="nav-progress" aria-hidden="true"></span>
  <div
    class="mx-auto flex max-w-6xl items-center justify-between gap-5 px-6 py-4"
  >
    <a href={href(cheminLangue(langue, "/"))} class="group flex items-center gap-3" aria-label="Accueil">
      <img
        src={href("/logo-96.png")}
        alt=""
        width="44"
        height="44"
        class="h-11 w-11 transition-transform duration-300 group-hover:rotate-6"
      />
      <span class="display text-lg text-navy-deep">{commun.marque.nom}</span>
    </a>

    {autresLangues.length > 0 && (
      <nav class="hidden items-center gap-2 lg:flex" aria-label="Langues">
        {autresLangues.map((l) => (
          <a href={l.href} hreflang={l.code} lang={l.code} class="nav-link uppercase" aria-label={l.nom}>
            {l.code}
          </a>
        ))}
      </nav>
    )}

    <nav
      class="hidden items-center gap-3 lg:flex xl:gap-4"
      aria-label="Navigation principale"
    >
      {
        commun.navigation.map((item) =>
          item.accent ? (
            <a href={href(lienContenu(langue, item.chemin))} class="btn btn-primary !px-4 !py-2.5 text-sm">
              {item.label}
            </a>
          ) : item.sous_menu.length > 0 ? (
            /*
              Entrée à raccourcis. L'entrée reste un lien ordinaire vers
              sa page — le sous-menu ne s'interpose jamais entre le
              visiteur et la page. Il se déploie au survol et à la mise
              au clavier, et se referme dès que le groupe perd le focus.
            */
            <div class="groupe-nav relative">
              <a
                href={href(lienContenu(langue, item.chemin))}
                class="nav-link !text-[0.92rem]"
                aria-current={isCurrent(lienContenu(langue, item.chemin)) ? "page" : undefined}
              >
                {item.label}
                {isCurrent(lienContenu(langue, item.chemin)) && (
                  <span
                    class="nav-souligne"
                    transition:name="nav-actif"
                    aria-hidden="true"
                  />
                )}
              </a>
              <div class="sous-menu" role="group" aria-label={item.label}>
                <ul class="sous-menu-liste">
                  {item.sous_menu.map((r) => (
                    <li>
                      <a
                        href={
                          r.ancre
                            ? `${href(lienContenu(langue, item.chemin))}#${r.ancre}`
                            : href(lienContenu(langue, r.chemin!))
                        }
                        class="sous-menu-lien"
                      >
                        {r.picto && (
                          <span class="sous-menu-picto" aria-hidden="true">
                            <Picto nom={r.picto} />
                          </span>
                        )}
                        {(() => {
                          const parts = decouperArca(r.label);
                          return parts ? (
                            <span>
                              {parts.avant}
                              <span class="mot-arca">ARCA</span>
                              {parts.apres}
                            </span>
                          ) : (
                            <span>{r.label}</span>
                          );
                        })()}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ) : (
            <a
              href={href(lienContenu(langue, item.chemin))}
              class="nav-link !text-[0.92rem]"
              aria-current={isCurrent(lienContenu(langue, item.chemin)) ? "page" : undefined}
            >
              {item.label}
              {isCurrent(lienContenu(langue, item.chemin)) && (
                <span
                  class="nav-souligne"
                  transition:name="nav-actif"
                  aria-hidden="true"
                />
              )}
            </a>
          ),
        )
      }
    </nav>

    <details class="relative lg:hidden">
      <summary
        class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full border border-ink/15 [&::-webkit-details-marker]:hidden"
        aria-label={commun.menu.ouvrir}
        aria-expanded="false"
      >
        <svg
          class="menu-icone h-5 w-5 text-ink"
          viewBox="0 0 20 20"
          fill="none"
          aria-hidden="true"
        >
          <path
            class="ligne-1"
            d="M3 5.5h14"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"></path>
          <path
            class="ligne-2"
            d="M3 10h14"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"></path>
          <path
            class="ligne-3"
            d="M3 14.5h14"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"></path>
        </svg>
      </summary>
      <nav class="menu-panneau" aria-label="Navigation mobile">
        <div class="menu-contenu">
          {autresLangues.length > 0 && (
            <div class="menu-groupe" style="--i: 0">
              {autresLangues.map((l) => (
                <a href={l.href} hreflang={l.code} lang={l.code} class="menu-entree uppercase">
                  {l.nom}
                </a>
              ))}
            </div>
          )}
          {
            commun.navigation.map((item, i) =>
              item.accent ? (
                <a href={href(lienContenu(langue, item.chemin))} class="menu-accent" style={`--i: ${i}`}>
                  {item.label}
                </a>
              ) : (
                <div class="menu-groupe" style={`--i: ${i}`}>
                  <a
                    href={href(lienContenu(langue, item.chemin))}
                    class="menu-entree"
                    aria-current={isCurrent(lienContenu(langue, item.chemin)) ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                  {/*
                    Sur mobile, pas de survol : les raccourcis sont
                    listés sous leur entrée, en retrait. Le panneau
                    reste une seule liste que l'on parcourt d'un coup,
                    sans niveau à ouvrir.
                  */}
                  {item.sous_menu.length > 0 && (
                    <ul class="menu-raccourcis">
                      {item.sous_menu.map((r) => (
                        <li>
                          <a
                            href={
                              r.ancre
                                ? `${href(lienContenu(langue, item.chemin))}#${r.ancre}`
                                : href(lienContenu(langue, r.chemin!))
                            }
                            class="menu-raccourci"
                          >
                            {r.picto && (
                              <span class="sous-menu-picto" aria-hidden="true">
                                <Picto nom={r.picto} />
                              </span>
                            )}
                            {(() => {
                              const parts = decouperArca(r.label);
                              return parts ? (
                                <span>
                                  {parts.avant}
                                  <span class="mot-arca">ARCA</span>
                                  {parts.apres}
                                </span>
                              ) : (
                                <span>{r.label}</span>
                              );
                            })()}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              ),
            )
          }
        </div>
      </nav>
    </details>
  </div>
</header>

<style>
  /*
    Sous-menus du bandeau de navigation.

    Ils n'ajoutent aucune entrée de premier niveau : les sept entrées de
    l'architecture V2 restent les sept mêmes. Ce sont des raccourcis vers
    l'intérieur des pages, qui donnent aussi à voir la structure du site
    d'un coup d'œil.

    Ouverture au survol ET au focus clavier : la tabulation traverse les
    liens du sous-menu sans qu'il faille cliquer quoi que ce soit.
    `:focus-within` suffit, sans JavaScript.
  */
  /*
    Le panneau ne flotte pas : il descend du bandeau.

    Version précédente — une carte arrondie détachée, posée sous le lien
    avec une ombre franche — se lisait comme un objet étranger déposé sur
    la page. Ici, le panneau démarre exactement au bas de l'en-tête,
    reprend son fond et son flou, et ne s'arrondit que par le bas :
    l'ensemble se lit comme une extension du bandeau qui se déplie.

    Le filet vert du haut prolonge le soulignement du lien parent — le
    même trait, qui court du mot au panneau.

    Le `padding-top` vaut exactement la distance entre le bas du lien et
    le bas de l'en-tête, mesurée à l'exécution (voir le script en fin de
    fichier). Une valeur figée se décalait dès que la hauteur du lien
    changeait — l'ajout du losange l'a fait de 4 px, et le changement de
    typographie à venir le referait. Ce padding sert aussi de pont :
    sans lui, le pointeur qui descend traverse un vide et le panneau se
    referme sous le doigt.
  */
  .sous-menu {
    position: absolute;
    top: 100%;
    /* Aligné sur le début du mot, et non centré : le filet du panneau
       prolonge alors exactement le soulignement du lien parent. Centré,
       il débordait à gauche et la continuité se perdait. */
    left: 0;
    z-index: 60;
    padding-top: var(--pont-sous-menu, 22px);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 200ms ease,
      visibility 0s linear 200ms;
  }

  .groupe-nav:hover .sous-menu,
  .groupe-nav:focus-within .sous-menu {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  /*
    Pendant et juste après une navigation, le survol ne compte pas.

    Voir le commentaire dans Base.astro : le curseur n'a pas bougé, mais
    le lien a changé sous lui — le panneau se rouvrait tout seul une
    demi-seconde après l'arrivée. La classe est retirée au premier
    mouvement du pointeur. Le focus clavier, lui, reste honoré.
  */
  :global(html.nav-figee) .groupe-nav:hover .sous-menu:not(:focus-within) {
    opacity: 0;
    visibility: hidden;
    transition: none;
  }

  .sous-menu-liste {
    min-width: 15rem;
    padding: 0.5rem;
    /* Même matière que l'en-tête : le panneau en est la suite. */
    background: color-mix(in oklab, var(--color-paper) 96%, transparent);
    /* Le dernier menu de la rangée ne doit pas sortir de la fenêtre. */
    max-width: min(20rem, calc(100vw - 2rem));
    backdrop-filter: blur(12px);
    border: 1px solid color-mix(in oklab, var(--color-ink) 8%, transparent);
    border-top: 2px solid var(--color-sage-deep);
    border-radius: 0 0 0.85rem 0.85rem;
    /* Une ombre à peine posée : elle donne la profondeur sans détacher. */
    box-shadow: 0 14px 28px -22px color-mix(in oklab, var(--color-ink) 55%, transparent);
    /* Le panneau se déroule vers le bas depuis le filet. */
    transform-origin: top center;
    animation: sous-menu-derouler 260ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes sous-menu-derouler {
    from {
      opacity: 0;
      transform: scaleY(0.94) translateY(-4px);
    }
  }

  .sous-menu-lien {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.65rem;
    border-radius: 0.5rem;
    font-size: 0.87rem;
    line-height: 1.3;
    color: var(--color-ink-soft);
    transition:
      background-color 180ms ease,
      color 180ms ease;
  }

  .sous-menu-lien:hover,
  .sous-menu-lien:focus-visible {
    background: var(--color-sage-faint);
    color: var(--color-navy-deep);
  }

  /* Le pictogramme de la page visée, à la même échelle que le texte. */
  .sous-menu-picto {
    display: inline-flex;
    flex: none;
    color: var(--color-sage-deep);
    opacity: 0.75;
    transition: opacity 180ms ease;
  }

  .sous-menu-picto :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }

  .sous-menu-lien:hover .sous-menu-picto {
    opacity: 1;
  }

  /*
    PANNEAU MOBILE.

    Version précédente : une carte de 256 px ancrée en `absolute` sous
    le bouton. Mesurée à 375 × 812, elle descendait à 882 px — 70 px
    hors de l'écran — sans défilement propre : « Contact » et « Espace
    apprenant » étaient inatteignables. D'où la refonte.

    Le panneau occupe maintenant toute la largeur sous le bandeau, se
    borne à la hauteur réellement visible et défile en interne.

    `dvh` et non `vh` : sur mobile la barre d'URL se rétracte au
    défilement, et `vh` reste figé sur la hauteur maximale — le bas du
    panneau repasserait sous le bord de l'écran.

    `overscroll-behavior: contain` plutôt qu'un verrouillage du `body` :
    arrivé en bout de liste, le geste ne se propage pas à la page
    derrière, sans les effets de bord du blocage sur iOS.
  */
  .menu-panneau {
    position: fixed;
    top: var(--hauteur-entete, 4.75rem);
    right: 0;
    left: 0;
    z-index: 50;
    max-height: calc(100dvh - var(--hauteur-entete, 4.75rem));
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--color-paper);
    border-bottom: 1px solid color-mix(in oklab, var(--color-ink) 10%, transparent);
    box-shadow: 0 18px 32px -26px color-mix(in oklab, var(--color-ink) 60%, transparent);
    animation: menu-derouler 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes menu-derouler {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  .menu-contenu {
    display: flex;
    flex-direction: column;
    padding: 0.5rem 1.25rem 1.5rem;
  }

  .menu-groupe + .menu-groupe {
    border-top: 1px solid color-mix(in oklab, var(--color-ink) 8%, transparent);
  }

  /* Cibles tactiles : 48 px pour les entrées, 44 px pour les
     raccourcis — au-dessus du minimum recommandé, doigt compris. */
  .menu-entree {
    display: flex;
    align-items: center;
    min-height: 3rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--color-navy-deep);
  }

  .menu-entree[aria-current="page"] {
    color: var(--color-sage-deep);
  }

  .menu-raccourcis {
    margin: 0 0 0.5rem;
    padding-left: 0.85rem;
    border-left: 2px solid color-mix(in oklab, var(--color-sage) 45%, transparent);
  }

  .menu-raccourci {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 2.75rem;
    font-size: 0.95rem;
    line-height: 1.3;
    color: var(--color-ink-soft);
  }

  .menu-accent {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    margin-top: 1rem;
    border-radius: 999px;
    background: var(--color-navy-deep);
    color: var(--color-paper);
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-panneau {
      animation: none;
    }
  }

  /*
    ARCA dans le menu : l'écho du traitement que le mot reçoit sur la
    page — capitales espacées, vert profond. Au survol, la même lueur
    que celle qui parcourt les lettres du titre quand un pilier se
    dévoile.
  */
  .mot-arca {
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-sage-deep);
    transition:
      color 200ms ease,
      text-shadow 320ms ease;
  }

  .sous-menu-lien:hover .mot-arca,
  .sous-menu-lien:focus-visible .mot-arca {
    animation: arca-lueur-menu 900ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @keyframes arca-lueur-menu {
    30% {
      text-shadow:
        0 0 0.5em color-mix(in oklab, var(--color-sage) 70%, transparent),
        0 0 0.12em rgb(255 255 255 / 0.85);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sous-menu,
    .sous-menu-lien,
    .sous-menu-picto,
    .mot-arca {
      transition: none;
    }
    .sous-menu-liste,
    .sous-menu-lien:hover .mot-arca {
      animation: none;
    }
  }
</style>

<script>
  /*
    Cale le sommet des sous-menus sur la ligne basse de l'en-tête.

    La distance dépend de la hauteur du lien, donc de la police et de la
    taille du texte : elle ne peut pas être écrite en dur sans se
    décaler au premier changement. On la mesure et on la publie en
    variable CSS — le style fait le reste.
  */
  function calerSousMenus() {
    const entete = document.querySelector<HTMLElement>("header");
    if (!entete) return;

    // Le panneau mobile démarre au bas du bandeau et ne peut pas
    // dépasser le bas de l'écran : les deux dépendent de cette hauteur.
    const hauteur = entete.getBoundingClientRect().height;
    document.documentElement.style.setProperty(
      "--hauteur-entete",
      `${Math.round(hauteur)}px`,
    );

    const lien = document.querySelector<HTMLElement>(".groupe-nav .nav-link");
    if (!lien) return;
    const pont = entete.getBoundingClientRect().bottom - lien.getBoundingClientRect().bottom;
    entete.style.setProperty("--pont-sous-menu", `${Math.max(0, Math.round(pont))}px`);
  }

  /*
    Fermeture du panneau mobile.
    <details> s'ouvre et se ferme sans JavaScript ; ce qu'il ne sait pas
    faire, c'est se refermer quand on part ailleurs. Trois sorties :
    un lien choisi, la touche d'échappement, un appui hors du panneau.
  */
  function fermer(): void {
    document
      .querySelectorAll<HTMLDetailsElement>("header details[open]")
      .forEach((d) => (d.open = false));
  }

  document.addEventListener("click", (e) => {
    const cible = e.target as HTMLElement | null;
    if (!cible) return;
    const details = document.querySelector<HTMLDetailsElement>("header details[open]");
    if (!details) return;
    // Le résumé gère lui-même sa bascule : ne pas la contrarier.
    if (cible.closest("summary")) return;
    if (cible.closest("a") || !cible.closest(".menu-panneau")) fermer();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") fermer();
  });

  calerSousMenus();
  document.addEventListener("astro:page-load", calerSousMenus);
  window.addEventListener("resize", calerSousMenus);
  // Les polices arrivent après le premier rendu et changent la hauteur
  // du lien : sans cette reprise, la mesure resterait celle de la police
  // de secours.
  document.fonts?.ready.then(calerSousMenus);
</script>
