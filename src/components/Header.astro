---
/**
 * Menu principal — version A de l'architecture V2 : les sept entrées du
 * schéma de Fabien, à plat, dans l'ordre du document.
 *
 * Contrainte de place : sept entrées textuelles réclament ~715 px à
 * côté du logo. Deux décisions leur font de la place — le slogan a été
 * retiré de la marque (26/07) et « Le Journal Pacivis » est raccourci
 * en « Le Journal » dans le menu comme dans le pied de page, la
 * rubrique gardant son nom complet en tête de sa propre page. En
 * dessous de 1024 px, bouton hamburger.
 *
 * Si la densité gêne encore, les leviers restants sont : rendre
 * « Accueil » implicite via le logo, ou revenir à un menu à quatre
 * entrées plus deux boutons d'action.
 */
import { href } from "../lib/url";
import { contenuLangue } from "../lib/contenu";
import { langueActive } from "../lib/langue-active";
import { cheminLangue, lienContenu } from "../lib/routes";
import { jumellesLangue } from "../lib/jumelles";
import { texteInterface } from "../lib/interface";
import { LANGUES, LANGUE_PAR_DEFAUT } from "../lib/langues";

// La langue se lit dans l'adresse : ce composant sert toutes les
// langues publiées, le contenu suit.
const langue = langueActive(Astro.url.pathname);
const { commun } = contenuLangue(langue);

/*
  Le sélecteur de langue : n'existe qu'à partir de deux langues publiées.
  Chaque langue mène à la page jumelle — portes et articles compris,
  appariés par nom de fichier — et se replie sur l'accueil de la langue
  quand la page n'y existe pas. La même résolution sert les `hreflang`
  dans Base.astro : voir lib/jumelles.ts pour pourquoi elle est unique.
*/
const langsPubliees = LANGUES.filter((l) => l.publiee);
const autresLangues = (
  await jumellesLangue(langue, Astro.url.pathname, import.meta.env.BASE_URL)
)
  .filter((j) => j.code !== langue)
  .map((j) => ({ code: j.code, nom: j.nom, href: href(j.chemin) }));
import Picto from "./Picto.astro";

/**
 * Isole le mot ARCA dans un libellé de raccourci.
 *
 * La page « Notre approche » fait vivre ce mot : ses quatre lettres
 * s'illuminent une à une, chacune parcourue d'une étincelle, à mesure
 * que le pilier correspondant se dévoile. Le menu reprend l'écho de ce
 * geste — les capitales espacées, la teinte verte, et la même lueur au
 * survol. Le lien et sa destination parlent ainsi la même langue, sans
 * que le visiteur ait à le remarquer.
 *
 * Découpage tolérant : un libellé sans le mot traverse la fonction sans
 * rien changer.
 */
function decouperArca(
  label: string,
): { avant: string; apres: string } | null {
  const i = label.indexOf("ARCA");
  if (i === -1) return null;
  return { avant: label.slice(0, i), apres: label.slice(i + 4) };
}

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const current = Astro.url.pathname.replace(base, "").replace(/\/+$/, "") || "/";

function isCurrent(path: string): boolean {
  if (path === "/") return current === "/";
  return current === path || current.startsWith(`${path}/`);
}
---

<header
  transition:animate="none"
  class="sticky top-0 z-40 border-b border-ink/10 bg-paper/85 backdrop-blur-md"
>
  <span class="nav-progress" aria-hidden="true"></span>
  <div
    class="mx-auto flex max-w-6xl items-center justify-between gap-5 px-6 py-4"
  >
    {/*
      Le nom accessible du logo vient du contenu de la langue active :
      c'est le seul texte que le lecteur d'écran annonce ici, l'image
      portant un `alt` vide. Écrit en dur, il restait « Accueil » sur les
      pages anglaises.
    */}
    <a
      href={href(cheminLangue(langue, "/"))}
      class="group flex items-center gap-3"
      aria-label={commun.fil.accueil}
      data-accueil
    >
      <img
        src={href("/logo-96.png")}
        alt=""
        width="44"
        height="44"
        class="h-11 w-11 transition-transform duration-300 group-hover:rotate-6"
      />
      <span class="display text-lg text-navy-deep">{commun.marque.nom}</span>
    </a>

    <nav
      class="hidden items-center gap-3 lg:flex xl:gap-4"
      aria-label={texteInterface(langue, "navigationPrincipale")}
    >
      {
        commun.navigation.map((item, i) => {
          /*
            Le sélecteur de langue s'accole à la DERNIÈRE entrée du menu.

            Repère structurel, et non stylistique : il était rendu dans la
            branche `item.accent`, si bien que décocher « mettre l'entrée
            en évidence » dans l'atelier retirait tout moyen de changer de
            langue au bandeau, l'anglais restant publié. Un choix de
            présentation ne doit pas pouvoir supprimer une fonction.

            Le rendu voulu est inchangé tant que l'entrée accentuée reste
            la dernière du menu — « Espace apprenant | FR » d'une seule
            forme (demande d'Olivier, 30/07).
          */
          const accole =
            i === commun.navigation.length - 1 && autresLangues.length > 0;
          const chemin = lienContenu(langue, item.chemin);
          const courant = isCurrent(chemin);

          const entree = item.accent ? (
            <a
              href={href(chemin)}
              class:list={[
                "btn btn-primary !px-4 !py-2.5 text-sm",
                accole && "!rounded-r-none",
              ]}
            >
              {item.label}
            </a>
          ) : item.sous_menu.length > 0 ? (
            /*
              Entrée à raccourcis. L'entrée reste un lien ordinaire vers
              sa page — le sous-menu ne s'interpose jamais entre le
              visiteur et la page. Il se déploie au survol et à la mise
              au clavier, et se referme dès que le groupe perd le focus.
            */
            <div class="groupe-nav relative">
              <a
                href={href(chemin)}
                class="nav-link !text-[0.92rem]"
                aria-current={courant ? "page" : undefined}
              >
                {item.label}
                {courant && (
                  <span
                    class="nav-souligne"
                    transition:name="nav-actif"
                    aria-hidden="true"
                  />
                )}
              </a>
              <div class="sous-menu" role="group" aria-label={item.label}>
                <ul class="sous-menu-liste">
                  {item.sous_menu.map((r) => (
                    <li>
                      <a
                        href={
                          r.ancre
                            ? `${href(chemin)}#${r.ancre}`
                            : href(lienContenu(langue, r.chemin!))
                        }
                        class="sous-menu-lien"
                      >
                        {r.picto && (
                          <span class="sous-menu-picto" aria-hidden="true">
                            <Picto nom={r.picto} />
                          </span>
                        )}
                        {(() => {
                          const parts = decouperArca(r.label);
                          return parts ? (
                            <span>
                              {parts.avant}
                              <span class="mot-arca">ARCA</span>
                              {parts.apres}
                            </span>
                          ) : (
                            <span>{r.label}</span>
                          );
                        })()}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ) : (
            <a
              href={href(chemin)}
              class:list={[
                "nav-link !text-[0.92rem]",
                accole && "!rounded-r-none",
              ]}
              aria-current={courant ? "page" : undefined}
            >
              {item.label}
              {courant && (
                <span
                  class="nav-souligne"
                  transition:name="nav-actif"
                  aria-hidden="true"
                />
              )}
            </a>
          );

          if (!accole) return entree;

          return (
            <div class="flex items-stretch">
              {entree}
              {/*
                Le segment des langues. Sémantique : un bouton de
                divulgation (`aria-expanded`), pas un menu ARIA —
                `aria-haspopup="true"` annonçait un menu alors que le
                panneau est un groupe de liens, et aucun état n'était
                exposé. Le script en fin de fichier tient `aria-expanded`
                à jour et permet l'ouverture au clic : sur un écran
                tactile large, il n'y a pas de survol pour la déclencher.
              */}
              <span class="groupe-nav groupe-langues relative flex">
                <button
                  type="button"
                  class="flex items-center gap-1 rounded-r-full border-l border-paper/25 bg-navy-deep pr-4 pl-3 text-[0.78rem] font-semibold tracking-[0.14em] text-paper uppercase transition-colors hover:bg-navy"
                  aria-expanded="false"
                  aria-controls="panneau-langues"
                  aria-label={texteInterface(langue, "langueActuelle", langue)}
                >
                  {langue}
                  <svg
                    aria-hidden="true"
                    class="h-2 w-2 text-paper/70"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </button>
                <div
                  id="panneau-langues"
                  class="sous-menu sous-menu-fin"
                  role="group"
                  aria-label={texteInterface(langue, "langues")}
                >
                  <ul class="sous-menu-liste">
                    {langsPubliees.map((l) =>
                      l.code === langue ? (
                        <li>
                          <span
                            class="sous-menu-lien font-semibold text-navy-deep"
                            aria-current="true"
                          >
                            {l.nom}
                          </span>
                        </li>
                      ) : (
                        <li>
                          <a
                            href={autresLangues.find((a) => a.code === l.code)!.href}
                            hreflang={l.code}
                            lang={l.code}
                            class="sous-menu-lien"
                          >
                            {l.nom}
                          </a>
                        </li>
                      ),
                    )}
                  </ul>
                </div>
              </span>
            </div>
          );
        })
      }
    </nav>


    <details class="relative lg:hidden">
      <summary
        class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full border border-ink/15 [&::-webkit-details-marker]:hidden"
        aria-label={commun.menu.ouvrir}
        aria-expanded="false"
      >
        <svg
          class="menu-icone h-5 w-5 text-ink"
          viewBox="0 0 20 20"
          fill="none"
          aria-hidden="true"
        >
          <path
            class="ligne-1"
            d="M3 5.5h14"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"></path>
          <path
            class="ligne-2"
            d="M3 10h14"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"></path>
          <path
            class="ligne-3"
            d="M3 14.5h14"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"></path>
        </svg>
      </summary>
      <nav class="menu-panneau" aria-label={texteInterface(langue, "navigationMobile")}>
        <div class="menu-contenu">
          {
            commun.navigation.map((item, i) =>
              item.accent ? (
                <a href={href(lienContenu(langue, item.chemin))} class="menu-accent" style={`--i: ${i}`}>
                  {item.label}
                </a>
              ) : (
                <div class="menu-groupe" style={`--i: ${i}`}>
                  <div class="menu-ligne">
                  <a
                    href={href(lienContenu(langue, item.chemin))}
                    class="menu-entree"
                    aria-current={isCurrent(lienContenu(langue, item.chemin)) ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                  {/*
                    Les raccourcis sont REPLIÉS par défaut (30/07).

                    Déployés, les sept entrées et leurs douze raccourcis
                    faisaient 1022 px de panneau : sur un téléphone en
                    paysage, 69 % du menu tombait hors écran et les
                    dernières entrées devenaient inatteignables sans
                    savoir qu'il fallait défiler. Repliés, les sept
                    entrées tiennent d'un coup d'œil, et chacune s'ouvre
                    d'un bouton. Le lien de l'entrée reste un lien : le
                    bouton ne s'interpose pas entre le visiteur et la
                    page.
                  */}
                  {item.sous_menu.length > 0 && (
                    <button
                      type="button"
                      class="menu-deplier"
                      aria-expanded="false"
                      aria-label={texteInterface(langue, "afficherRaccourcis", item.label)}
                    >
                      <svg
                        aria-hidden="true"
                        class="menu-chevron h-3.5 w-3.5"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="m6 9 6 6 6-6" />
                      </svg>
                    </button>
                  )}
                  </div>
                  {item.sous_menu.length > 0 && (
                    <ul class="menu-raccourcis" hidden>
                      {item.sous_menu.map((r) => (
                        <li>
                          <a
                            href={
                              r.ancre
                                ? `${href(lienContenu(langue, item.chemin))}#${r.ancre}`
                                : href(lienContenu(langue, r.chemin!))
                            }
                            class="menu-raccourci"
                          >
                            {r.picto && (
                              <span class="sous-menu-picto" aria-hidden="true">
                                <Picto nom={r.picto} />
                              </span>
                            )}
                            {(() => {
                              const parts = decouperArca(r.label);
                              return parts ? (
                                <span>
                                  {parts.avant}
                                  <span class="mot-arca">ARCA</span>
                                  {parts.apres}
                                </span>
                              ) : (
                                <span>{r.label}</span>
                              );
                            })()}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              ),
            )
          }
          {autresLangues.length > 0 && (
            <div class="menu-langues" aria-label={texteInterface(langue, "langues")}>
              {langsPubliees.map((l) =>
                l.code === langue ? (
                  <span class="menu-langue menu-langue-courante" aria-current="true" lang={l.code}>
                    {l.code}
                  </span>
                ) : (
                  <a
                    href={autresLangues.find((a) => a.code === l.code)!.href}
                    hreflang={l.code}
                    lang={l.code}
                    aria-label={l.nom}
                    class="menu-langue"
                  >
                    {l.code}
                  </a>
                ),
              )}
            </div>
          )}
        </div>
      </nav>
    </details>
  </div>
</header>

<style>
  /*
    Sous-menus du bandeau de navigation.

    Ils n'ajoutent aucune entrée de premier niveau : les sept entrées de
    l'architecture V2 restent les sept mêmes. Ce sont des raccourcis vers
    l'intérieur des pages, qui donnent aussi à voir la structure du site
    d'un coup d'œil.

    Ouverture au survol ET au focus clavier : la tabulation traverse les
    liens du sous-menu sans qu'il faille cliquer quoi que ce soit.
    `:focus-within` suffit, sans JavaScript.
  */
  /*
    Le panneau ne flotte pas : il descend du bandeau.

    Version précédente — une carte arrondie détachée, posée sous le lien
    avec une ombre franche — se lisait comme un objet étranger déposé sur
    la page. Ici, le panneau démarre exactement au bas de l'en-tête,
    reprend son fond et son flou, et ne s'arrondit que par le bas :
    l'ensemble se lit comme une extension du bandeau qui se déplie.

    Le filet vert du haut prolonge le soulignement du lien parent — le
    même trait, qui court du mot au panneau.

    Le `padding-top` vaut exactement la distance entre le bas du lien et
    le bas de l'en-tête, mesurée à l'exécution (voir le script en fin de
    fichier). Une valeur figée se décalait dès que la hauteur du lien
    changeait — l'ajout du losange l'a fait de 4 px, et le changement de
    typographie à venir le referait. Ce padding sert aussi de pont :
    sans lui, le pointeur qui descend traverse un vide et le panneau se
    referme sous le doigt.
  */
  .sous-menu {
    position: absolute;
    top: 100%;
    /* Aligné sur le début du mot, et non centré : le filet du panneau
       prolonge alors exactement le soulignement du lien parent. Centré,
       il débordait à gauche et la continuité se perdait. */
    left: 0;
    z-index: 60;
    padding-top: var(--pont-sous-menu, 22px);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 200ms ease,
      visibility 0s linear 200ms;
  }

  .groupe-nav:hover .sous-menu,
  .groupe-nav:focus-within .sous-menu {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  /*
    Ouverture au clic, en plus du survol : une tablette en paysage reçoit
    le bandeau de bureau sans jamais émettre de survol. La classe est
    posée par le script, qui recale aussi `aria-expanded`.
  */
  .groupe-nav.langues-ouvert .sous-menu {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  /*
    La fermeture explicite l'emporte sur le survol et le focus.

    Sans elle, refermer au clavier laissait le panneau à l'écran : le
    bouton garde le focus — l'utilisateur ne doit pas perdre sa place —
    et `:focus-within` le rouvrait aussitôt. Le script lève la classe dès
    que le pointeur ou le focus quitte le groupe.
  */
  .groupe-nav.langues-close:hover .sous-menu,
  .groupe-nav.langues-close:focus-within .sous-menu {
    opacity: 0;
    visibility: hidden;
  }

  /*
    Pendant et juste après une navigation, le survol ne compte pas.

    Voir le commentaire dans Base.astro : le curseur n'a pas bougé, mais
    le lien a changé sous lui — le panneau se rouvrait tout seul une
    demi-seconde après l'arrivée. La classe est retirée au premier
    mouvement du pointeur. Le focus clavier, lui, reste honoré.
  */
  :global(html.nav-figee) .groupe-nav:hover .sous-menu:not(:focus-within) {
    opacity: 0;
    visibility: hidden;
    transition: none;
  }

  /*
    Le panneau des langues pend du bout droit du bandeau : ancré à
    droite de son segment — jamais hors fenêtre — et ponté vers le filet
    par sa propre mesure (le segment est plus haut qu'un lien de menu,
    le pont générique tombait trop bas).
  */
  .sous-menu-fin {
    right: 0;
    left: auto;
    padding-top: var(--pont-langues, 12px);
  }

  .sous-menu-liste {
    min-width: 15rem;
    padding: 0.5rem;
    /* Même matière que l'en-tête : le panneau en est la suite. */
    background: color-mix(in oklab, var(--color-paper) 96%, transparent);
    /* Le dernier menu de la rangée ne doit pas sortir de la fenêtre. */
    max-width: min(20rem, calc(100vw - 2rem));
    backdrop-filter: blur(12px);
    border: 1px solid color-mix(in oklab, var(--color-ink) 8%, transparent);
    border-top: 2px solid var(--color-sage-deep);
    border-radius: 0 0 0.85rem 0.85rem;
    /* Une ombre à peine posée : elle donne la profondeur sans détacher. */
    box-shadow: 0 14px 28px -22px color-mix(in oklab, var(--color-ink) 55%, transparent);
    /* Le panneau se déroule vers le bas depuis le filet. */
    transform-origin: top center;
    animation: sous-menu-derouler 260ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes sous-menu-derouler {
    from {
      opacity: 0;
      transform: scaleY(0.94) translateY(-4px);
    }
  }

  .sous-menu-lien {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.65rem;
    border-radius: 0.5rem;
    font-size: 0.87rem;
    line-height: 1.3;
    color: var(--color-ink-soft);
    transition:
      background-color 180ms ease,
      color 180ms ease;
  }

  .sous-menu-lien:hover,
  .sous-menu-lien:focus-visible {
    background: var(--color-sage-faint);
    color: var(--color-navy-deep);
  }

  /* Le pictogramme de la page visée, à la même échelle que le texte. */
  .sous-menu-picto {
    display: inline-flex;
    flex: none;
    color: var(--color-sage-deep);
    opacity: 0.75;
    transition: opacity 180ms ease;
  }

  .sous-menu-picto :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }

  .sous-menu-lien:hover .sous-menu-picto {
    opacity: 1;
  }

  /*
    PANNEAU MOBILE.

    Version précédente : une carte de 256 px ancrée en `absolute` sous
    le bouton. Mesurée à 375 × 812, elle descendait à 882 px — 70 px
    hors de l'écran — sans défilement propre : « Contact » et « Espace
    apprenant » étaient inatteignables. D'où la refonte.

    Le panneau occupe maintenant toute la largeur sous le bandeau, se
    borne à la hauteur réellement visible et défile en interne.

    `dvh` et non `vh` : sur mobile la barre d'URL se rétracte au
    défilement, et `vh` reste figé sur la hauteur maximale — le bas du
    panneau repasserait sous le bord de l'écran.

    `overscroll-behavior: contain` plutôt qu'un verrouillage du `body` :
    arrivé en bout de liste, le geste ne se propage pas à la page
    derrière, sans les effets de bord du blocage sur iOS.
  */
  .menu-panneau {
    position: fixed;
    top: var(--hauteur-entete, 4.75rem);
    right: 0;
    left: 0;
    z-index: 50;
    max-height: calc(100dvh - var(--hauteur-entete, 4.75rem));
    overflow-y: auto;
    overscroll-behavior: contain;
    /*
      L'ombre qui dit qu'il reste du contenu.

      Sur un écran court — un téléphone en paysage — le panneau déborde
      même replié, et rien ne l'indiquait : les dernières entrées
      semblaient ne pas exister. Les deux dégradés « scroll » se
      révèlent au bord concerné et disparaissent en butée, sans une
      ligne de script (technique éprouvée : les couches `local` masquent
      les couches `scroll` quand on est en haut ou en bas).
    */
    background:
      linear-gradient(var(--color-paper) 30%, transparent) top / 100% 2rem no-repeat local,
      linear-gradient(transparent, var(--color-paper) 70%) bottom / 100% 2rem no-repeat local,
      radial-gradient(farthest-side at 50% 0, color-mix(in oklab, var(--color-ink) 22%, transparent), transparent)
        top / 100% 0.6rem no-repeat scroll,
      radial-gradient(farthest-side at 50% 100%, color-mix(in oklab, var(--color-ink) 22%, transparent), transparent)
        bottom / 100% 0.6rem no-repeat scroll,
      var(--color-paper);
    border-bottom: 1px solid color-mix(in oklab, var(--color-ink) 10%, transparent);
    box-shadow: 0 18px 32px -26px color-mix(in oklab, var(--color-ink) 60%, transparent);
    animation: menu-derouler 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes menu-derouler {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  .menu-contenu {
    display: flex;
    flex-direction: column;
    padding: 0.5rem 1.25rem 1.5rem;
  }

  /*
    Une entrée du panneau : son lien à gauche, son bouton de dépliage à
    droite. Deux cibles distinctes de 48 px, jamais superposées.
  */
  .menu-ligne {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .menu-ligne .menu-entree {
    flex: 1;
  }

  .menu-deplier {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 3rem;
    min-height: 3rem;
    color: var(--color-ink-faint);
    cursor: pointer;
    transition: color 160ms ease;
  }

  .menu-deplier:hover {
    color: var(--color-navy-deep);
  }

  .menu-chevron {
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .menu-deplier[aria-expanded="true"] .menu-chevron {
    transform: rotate(180deg);
  }

  .menu-raccourcis[hidden] {
    display: none;
  }

  /*
    Écran court (téléphone en paysage, fenêtre réduite) : le panneau se
    resserre pour montrer davantage d'entrées d'un coup. Les cibles
    tactiles restent au-dessus du minimum recommandé.
  */
  @media (max-height: 520px) {
    .menu-contenu {
      padding-block: 0.25rem 0.75rem;
    }

    .menu-entree {
      min-height: 2.5rem;
      font-size: 1rem;
    }

    .menu-deplier {
      min-height: 2.5rem;
    }

    .menu-accent {
      margin-block: 0.5rem;
    }

    .menu-langues {
      margin-top: 0.5rem;
      padding-top: 0.5rem;
    }
  }

  .menu-langues {
    display: flex;
    gap: 0.35rem;
    align-items: center;
    margin-top: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in oklab, var(--color-ink) 8%, transparent);
  }

  .menu-langue {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--color-ink-faint);
    text-transform: uppercase;
  }

  .menu-langue-courante {
    font-weight: 700;
    color: var(--color-navy-deep);
  }

  .menu-groupe + .menu-groupe {
    border-top: 1px solid color-mix(in oklab, var(--color-ink) 8%, transparent);
  }

  /* Cibles tactiles : 48 px pour les entrées, 44 px pour les
     raccourcis — au-dessus du minimum recommandé, doigt compris. */
  .menu-entree {
    display: flex;
    align-items: center;
    min-height: 3rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--color-navy-deep);
  }

  .menu-entree[aria-current="page"] {
    color: var(--color-sage-deep);
  }

  .menu-raccourcis {
    margin: 0 0 0.5rem;
    padding-left: 0.85rem;
    border-left: 2px solid color-mix(in oklab, var(--color-sage) 45%, transparent);
  }

  .menu-raccourci {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 2.75rem;
    font-size: 0.95rem;
    line-height: 1.3;
    color: var(--color-ink-soft);
  }

  .menu-accent {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    margin-top: 1rem;
    border-radius: 999px;
    background: var(--color-navy-deep);
    color: var(--color-paper);
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-panneau {
      animation: none;
    }
  }

  /*
    ARCA dans le menu : l'écho du traitement que le mot reçoit sur la
    page — capitales espacées, vert profond. Au survol, la même lueur
    que celle qui parcourt les lettres du titre quand un pilier se
    dévoile.
  */
  .mot-arca {
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-sage-deep);
    transition:
      color 200ms ease,
      text-shadow 320ms ease;
  }

  .sous-menu-lien:hover .mot-arca,
  .sous-menu-lien:focus-visible .mot-arca {
    animation: arca-lueur-menu 900ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @keyframes arca-lueur-menu {
    30% {
      text-shadow:
        0 0 0.5em color-mix(in oklab, var(--color-sage) 70%, transparent),
        0 0 0.12em rgb(255 255 255 / 0.85);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sous-menu,
    .sous-menu-lien,
    .sous-menu-picto,
    .mot-arca {
      transition: none;
    }
    .sous-menu-liste,
    .sous-menu-lien:hover .mot-arca {
      animation: none;
    }
  }
</style>

<script>
  /*
    Cale le sommet des sous-menus sur la ligne basse de l'en-tête.

    La distance dépend de la hauteur du lien, donc de la police et de la
    taille du texte : elle ne peut pas être écrite en dur sans se
    décaler au premier changement. On la mesure et on la publie en
    variable CSS — le style fait le reste.
  */
  function calerSousMenus() {
    const entete = document.querySelector<HTMLElement>("header");
    if (!entete) return;

    // Le panneau mobile démarre au bas du bandeau et ne peut pas
    // dépasser le bas de l'écran : les deux dépendent de cette hauteur.
    const hauteur = entete.getBoundingClientRect().height;
    document.documentElement.style.setProperty(
      "--hauteur-entete",
      `${Math.round(hauteur)}px`,
    );

    const lien = document.querySelector<HTMLElement>(".groupe-nav .nav-link");
    if (!lien) return;
    const pont = entete.getBoundingClientRect().bottom - lien.getBoundingClientRect().bottom;
    entete.style.setProperty("--pont-sous-menu", `${Math.max(0, Math.round(pont))}px`);
    /*
      Repéré par sa classe, pas par un attribut ARIA : cette mesure aligne
      le liseré du panneau sur le filet du bandeau, et une mise en page ne
      doit pas dépendre d'un choix de sémantique. Le sélecteur précédent,
      `button[aria-haspopup="true"]`, est devenu muet le jour où cette
      sémantique fautive a été retirée — l'alignement serait tombé sans
      que rien ne le signale.
    */
    const boutonLangue = document.querySelector<HTMLElement>(".groupe-langues button");
    if (boutonLangue) {
      const pontLangues =
        entete.getBoundingClientRect().bottom - boutonLangue.getBoundingClientRect().bottom;
      entete.style.setProperty("--pont-langues", `${Math.max(0, Math.round(pontLangues))}px`);
    }
  }

  /*
    Dépliage d'une entrée du panneau mobile.

    Le bouton bascule sa liste de raccourcis. Rien n'est déplié au
    chargement : le panneau montre d'abord ses sept entrées, ce qui
    tient sur l'écran le plus court. Délégué sur le document — le
    panneau est reconstruit à chaque navigation.
  */
  document.addEventListener("click", (evenement) => {
    const bouton = (evenement.target as HTMLElement | null)?.closest?.(
      ".menu-deplier",
    ) as HTMLButtonElement | null;
    if (!bouton) return;
    evenement.preventDefault();
    const groupe = bouton.closest(".menu-groupe");
    const liste = groupe?.querySelector<HTMLElement>(".menu-raccourcis");
    if (!liste) return;
    const ouvert = bouton.getAttribute("aria-expanded") === "true";
    bouton.setAttribute("aria-expanded", String(!ouvert));
    liste.hidden = ouvert;
  });

  /*
    Fermeture du panneau mobile.
    <details> s'ouvre et se ferme sans JavaScript ; ce qu'il ne sait pas
    faire, c'est se refermer quand on part ailleurs. Trois sorties :
    un lien choisi, la touche d'échappement, un appui hors du panneau.
  */
  function fermer(): void {
    document
      .querySelectorAll<HTMLDetailsElement>("header details[open]")
      .forEach((d) => (d.open = false));
  }

  document.addEventListener("click", (e) => {
    const cible = e.target as HTMLElement | null;
    if (!cible) return;
    const details = document.querySelector<HTMLDetailsElement>("header details[open]");
    if (!details) return;
    // Le résumé gère lui-même sa bascule : ne pas la contrarier.
    if (cible.closest("summary")) return;
    if (cible.closest("a") || !cible.closest(".menu-panneau")) fermer();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") fermer();
  });

  /*
    L'ÉTAT DU SÉLECTEUR DE LANGUE.

    Le panneau s'ouvre en CSS, au survol et à la mise au clavier. Le
    bouton doit donc dire un état qu'il ne décide pas : `aria-expanded`
    est recalé sur l'ouverture RÉELLE, à chaque événement qui la change.
    Sans cela il annonçait « replié » en permanence — et il annonçait
    même un menu ARIA (`aria-haspopup`) là où le panneau est un groupe de
    liens.

    Le clic est ajouté par-dessus : sur un écran tactile large — une
    tablette en paysage voit le bandeau de bureau — il n'y a pas de
    survol, et le panneau était inatteignable autrement qu'au clavier.
  */
  function calerLangues(): void {
    const groupe = document.querySelector<HTMLElement>(".groupe-langues");
    const bouton = groupe?.querySelector<HTMLButtonElement>("button");
    if (!groupe || !bouton) return;

    const dire = (ouvert: boolean) =>
      bouton.setAttribute("aria-expanded", String(ouvert));
    const ouvert = () =>
      groupe.classList.contains("langues-ouvert") ||
      groupe.matches(":hover") ||
      groupe.contains(document.activeElement);

    /*
      Un seul jeu de gestionnaires par bouton.

      Cette fonction tourne au premier chargement ET sur le
      `astro:page-load` que le routeur émet aussitôt : sans ce drapeau,
      deux écouteurs de clic se posaient sur le même bouton, le premier
      ouvrait le panneau et le second le refermait dans la foulée. Le
      défaut était invisible à la souris — le bouton garde le focus après
      un clic, et `:focus-within` rouvrait le panneau — mais un appui au
      doigt, sur une tablette où le survol n'existe pas et où Safari ne
      donne pas le focus à un bouton, ne l'ouvrait jamais.

      Le bandeau est reconstruit à chaque navigation : le drapeau
      disparaît avec l'ancien bouton, et le nouveau se réarme.
    */
    dire(ouvert());
    if (bouton.dataset.languesCalees) return;
    bouton.dataset.languesCalees = "1";

    /*
      FERMER doit fermer POUR DE BON.

      Le panneau s'ouvre aussi par `:focus-within`. Or refermer au clavier
      laisse le focus sur le bouton — c'est voulu, l'utilisateur ne doit
      pas perdre sa place — si bien que le panneau restait affiché quand
      `aria-expanded` annonçait « replié ». Même chose au second clic à la
      souris. L'état annoncé et l'écran se contredisaient.

      D'où `langues-close` : une fermeture EXPLICITE, que le CSS honore
      par-dessus le survol et le focus. Elle se lève dès que le pointeur
      ou le focus quitte le groupe — le comportement ordinaire reprend à
      la visite suivante, sans qu'il faille cliquer pour le débloquer.
    */
    const fermer = () => {
      groupe.classList.remove("langues-ouvert");
      groupe.classList.add("langues-close");
      dire(false);
    };
    const rouvrirPossible = () => groupe.classList.remove("langues-close");

    /*
      Le clic bascule l'ouverture EXPLICITE, pas ce qui est à l'écran.

      À la souris, cliquer suppose d'avoir survolé : le panneau est déjà
      ouvert au moment du clic. Juger sur l'état visuel faisait donc
      refermer au premier clic — le sélecteur devenait inutilisable à la
      souris tout en restant correct au doigt.
    */
    bouton.addEventListener("click", () => {
      if (groupe.classList.contains("langues-ouvert")) {
        fermer();
        return;
      }
      rouvrirPossible();
      groupe.classList.add("langues-ouvert");
      dire(true);
    });

    for (const evenement of ["pointerenter", "focusin"]) {
      groupe.addEventListener(evenement, () => {
        requestAnimationFrame(() => dire(ouvert()));
      });
    }
    for (const evenement of ["pointerleave", "focusout"]) {
      groupe.addEventListener(evenement, () => {
        // Le focus part avant d'arriver : lire à la frame suivante.
        requestAnimationFrame(() => {
          if (groupe.matches(":hover") || groupe.contains(document.activeElement)) {
            dire(ouvert());
            return;
          }
          // Sorti pour de bon : la fermeture explicite a fait son office.
          groupe.classList.remove("langues-ouvert");
          rouvrirPossible();
          dire(false);
        });
      });
    }

    // Un choix de langue navigue ; l'échappement referme sans naviguer.
    groupe.addEventListener("keydown", (e) => {
      if ((e as KeyboardEvent).key !== "Escape") return;
      fermer();
      bouton.focus();
    });
  }

  calerSousMenus();
  calerLangues();
  document.addEventListener("astro:page-load", calerSousMenus);
  document.addEventListener("astro:page-load", calerLangues);
  window.addEventListener("resize", calerSousMenus);
  // Les polices arrivent après le premier rendu et changent la hauteur
  // du lien : sans cette reprise, la mesure resterait celle de la police
  // de secours.
  document.fonts?.ready.then(calerSousMenus);
</script>
