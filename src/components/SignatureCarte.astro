---
/**
 * La signature d'une situation — déclinaison du motif de marque.
 *
 * Le site porte déjà un motif signature : une ligne qui part agitée et
 * se stabilise (« de la tension à la maîtrise »). Plutôt que d'ajouter
 * des images qui concurrencent le logo, chaque carte reçoit SA variante
 * de ce tracé : la forme raconte la dynamique dont parle le texte.
 *
 * Le tracé se dessine à l'ouverture de la carte, puis ne bouge plus.
 * Un trait de 2 px reste très en dessous du logo dans la hiérarchie
 * visuelle — c'est le but.
 */
interface Props {
  /** Quelle dynamique la carte décrit. */
  forme:
    | "oscillation"
    | "pic"
    | "endurance"
    | "paliers"
    | "greffe"
    | "referentiel"
    | "construction"
    | "progression";
  class?: string;
}

// `rest` laisse passer les attributs de la page hôte — notamment
// `data-reveal`, qui déclenche le tracé au défilement là où il n'y a pas
// d'accordéon pour le faire.
const { forme, class: className = "", ...rest } = Astro.props;

/*
  UN SEUL DESSIN, DÉCLINÉ.

  La page d'accueil porte le motif de la marque : une ligne qui part en
  dents anguleuses, dont l'amplitude décroît à chaque aller-retour,
  jusqu'à s'apaiser en une horizontale tenue — « de la tension à la
  maîtrise ». Les signatures des cartes reprennent exactement cette
  grammaire, au lieu des huit formes séparées d'avant : le tracé est
  généré ici par le même calcul, seuls les réglages changent.

  Même repère que l'accueil (viewBox 1200 × 110) : c'est ce qui garantit
  que les dents ont la même pente et la même vigueur. Un repère plus
  plat, étiré par `preserveAspectRatio="none"`, écrasait les tracés —
  c'est ce qui les faisait paraître mal dessinés.
*/
const LARGEUR = 1200;
const HORIZON = 55;

interface Reglages {
  /** Nombre d'aller-retours avant l'apaisement. */
  dents: number;
  /** Écart vertical de la première dent, en unités du repère. */
  amplitude: number;
  /** Ce qu'il reste de l'amplitude à chaque dent (0,82 = -18 %). */
  amortissement: number;
  /** Portion de la largeur occupée par la partie agitée. */
  part: number;
  /** Décalage vertical de la ligne d'arrivée, pour les fins qui dérivent. */
  derive?: number;
  /** Départ calme avant la première dent, en portion de largeur. */
  attente?: number;
}

const REGLAGES: Record<Props["forme"], Reglages> = {
  // Le motif de référence : une agitation franche qui se dénoue.
  oscillation: { dents: 12, amplitude: 41, amortissement: 0.86, part: 0.42 },
  // Long calme, un éclat bref et violent, retour immédiat au calme.
  pic: { dents: 4, amplitude: 48, amortissement: 0.6, part: 0.16, attente: 0.4 },
  // L'amplitude ne s'effondre pas : tenir l'intensité dans la durée.
  endurance: { dents: 14, amplitude: 30, amortissement: 0.985, part: 0.72 },
  // L'agitation s'apaise, mais la ligne d'arrivée reste plus basse
  // qu'au départ : la dégradation a laissé une trace.
  paliers: { dents: 10, amplitude: 38, amortissement: 0.85, part: 0.45, derive: 16 },
  // Une secousse contenue, vite reprise : le module qui vient se poser
  // sur un parcours déjà en place.
  greffe: { dents: 6, amplitude: 34, amortissement: 0.78, part: 0.3, attente: 0.12 },
  // Peu de dents, largement amorties : le cadre impose sa mesure.
  referentiel: { dents: 8, amplitude: 26, amortissement: 0.8, part: 0.34 },
  // L'agitation s'étale, puis se resserre : l'intervention se construit.
  construction: { dents: 9, amplitude: 36, amortissement: 0.88, part: 0.52 },
  // Départ bas, apaisement, et la ligne finit plus haut : on progresse.
  progression: {
    dents: 8,
    amplitude: 32,
    amortissement: 0.83,
    part: 0.4,
    derive: -18,
  },
};

/**
 * Construit le tracé : plateau d'attente, dents d'amplitude
 * décroissante, puis raccord courbe vers l'horizontale finale.
 *
 * La courbe de raccord est ce qui distingue l'apaisement d'une coupure
 * nette — c'est elle qui donne au motif de l'accueil sa fin « posée ».
 */
function tracer(r: Reglages): string {
  const attente = LARGEUR * (r.attente ?? 0);
  const finAgitation = attente + LARGEUR * r.part;
  const pas = (finAgitation - attente) / r.dents;
  const arrivee = HORIZON + (r.derive ?? 0);

  const points: string[] = [`M0 ${HORIZON}`];
  if (attente > 0) points.push(`L${Math.round(attente)} ${HORIZON}`);

  let amplitude = r.amplitude;
  for (let i = 0; i < r.dents; i++) {
    const x = attente + pas * (i + 1);
    // Une dent sur deux vers le haut : c'est l'alternance qui fait le
    // motif, pas la seule décroissance.
    const y = HORIZON + (i % 2 === 0 ? -amplitude : amplitude);
    points.push(`L${Math.round(x)} ${Math.round(y)}`);
    amplitude *= r.amortissement;
  }

  // Raccord : deux points de contrôle qui absorbent la dernière dent.
  const c1 = finAgitation + (LARGEUR - finAgitation) * 0.12;
  const c2 = finAgitation + (LARGEUR - finAgitation) * 0.3;
  points.push(
    `C${Math.round(c1)} ${Math.round(arrivee)}, ${Math.round(c2)} ${Math.round(arrivee)}, ${Math.round(c2 + 40)} ${Math.round(arrivee)}`,
  );
  points.push(`L${LARGEUR} ${Math.round(arrivee)}`);
  return points.join(" ");
}

const TRACES = Object.fromEntries(
  Object.entries(REGLAGES).map(([nom, r]) => [nom, tracer(r)]),
) as Record<Props["forme"], string>;
---

<svg
  class={`signature-carte ${className}`}
  viewBox="0 0 1200 110"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  preserveAspectRatio="none"
  {...rest}
>
  <path
    d={TRACES[forme]}
    pathLength="1"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    vector-effect="non-scaling-stroke"></path>
</svg>

<style>
  /*
    Styles portés par le composant lui-même : un style scopé au parent
    n'atteindrait pas ce SVG.
  */
  .signature-carte {
    display: block;
    width: 100%;
    /* Le repère du motif fait 1200 × 110. Rendu sur ~64 rem de large,
       il lui faut ~4,5 rem de haut pour garder la pente de l'accueil ;
       en dessous, les dents s'aplatissent. */
    height: 4.5rem;
    color: var(--color-sage-deep);
    opacity: 0.55;
  }

  /* Signature portée par la page entière : plus ample, plus aérée. */
  .signature-carte.signature-page {
    height: 5.5rem;
    margin-top: 3rem;
    max-width: 44rem;
  }

  /*
    Sur ces pages il n'y a pas d'accordéon pour déclencher le tracé :
    c'est l'entrée dans le champ de vision qui s'en charge, via le
    système de révélation du site.

    Une animation, et non une transition : la signature étant souvent
    visible dès le chargement, la classe `revealed` arrive dans le même
    souffle que `js-reveal` et l'état de départ ne serait jamais rendu.
    `backwards` garantit qu'il l'est. Sans JavaScript, la ligne est
    simplement là, tracée.
  */
  :global(html.js-reveal) .signature-page:global(.revealed) path {
    animation: signature-tracer 1400ms cubic-bezier(0.45, 0.05, 0.3, 1)
      backwards;
    animation-delay: 220ms;
  }

  @keyframes signature-tracer {
    from {
      stroke-dashoffset: 1;
    }
  }

  /*
    Le tracé se dessine à l'ouverture de la carte. `@starting-style` est
    indispensable : <details> ne rend pas son contenu tant qu'il est
    fermé, donc sans état de départ déclaré il n'y a rien à interpoler.
    Les navigateurs qui l'ignorent affichent la ligne déjà tracée — la
    carte reste correcte.
  */
  .signature-carte path {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1400ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @starting-style {
    :global(details[open]) .signature-carte path {
      stroke-dashoffset: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signature-carte path {
      transition: none;
    }
  }
</style>
