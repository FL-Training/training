---
import DeescalationLine from "./DeescalationLine.astro";
import { href } from "../lib/url";
import { contenuLangue } from "../lib/contenu";
import { langueActive } from "../lib/langue-active";
import { cheminLangue, lienContenu } from "../lib/routes";

// La langue se lit dans l'adresse : ce composant sert toutes les
// langues publiées, le contenu suit.
const langue = langueActive(Astro.url.pathname);
const { commun } = contenuLangue(langue);
import { enrichir } from "../lib/texte";

const pied = commun.pied_de_page;
const year = new Date().getFullYear();
---

<footer class="bg-abysse text-paper">
  <div class="mx-auto max-w-6xl px-6 pt-14 pb-8">
    <DeescalationLine class="mb-12 h-10 opacity-55" mode="defilement" />

    <div class="grid gap-10 sm:grid-cols-2 md:grid-cols-4">
      <div>
        <div class="flex items-center gap-3">
          <span
            class="flex h-10 w-10 items-center justify-center rounded-full bg-paper"
          >
            <img
              src={href("/logo-96.png")}
              alt=""
              width="32"
              height="32"
              class="h-8 w-8"
            />
          </span>
          <span class="display text-lg">{commun.marque.nom}</span>
        </div>
        <p
          class="mt-4 max-w-xs text-sm leading-relaxed text-paper/70"
          set:html={enrichir(pied.description, "text-sage")}
        />
      </div>

      {/*
        Chaque bloc du pied de page est nommé par son titre VISIBLE, pas
        par un `aria-label` écrit à côté. Deux raisons : le nom suit
        automatiquement la langue et les retouches de Fabien, et le
        lecteur d'écran annonce exactement ce que l'écran affiche —
        l'ancien `aria-label="Secteurs"` nommait une colonne intitulée
        « Formations ».
      */}
      <nav aria-labelledby="pied-titre-site">
        <h2 id="pied-titre-site" class="eyebrow !text-sage">{pied.titre_site}</h2>
        <ul class="mt-4 space-y-2 text-sm">
          {
            pied.liens_site.map((item) => (
              <li>
                <a
                  class="lien-pied text-paper/80 hover:text-paper"
                  href={href(lienContenu(langue, item.chemin))}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-labelledby="pied-titre-secteurs">
        <h2 id="pied-titre-secteurs" class="eyebrow !text-sage">{pied.titre_secteurs}</h2>
        <ul class="mt-4 space-y-2 text-sm">
          {
            pied.liens_secteurs.map((item) => (
              <li>
                <a
                  class="lien-pied text-paper/80 hover:text-paper"
                  href={href(lienContenu(langue, item.chemin))}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="eyebrow !text-sage">{pied.titre_echanger}</h2>
        <p
          class="mt-4 text-sm text-paper/70"
          set:html={enrichir(pied.texte_echanger, "text-sage")}
        />
        <div class="mt-5 flex flex-wrap gap-3">
          <a
            href={href(cheminLangue(langue, "/contact"))}
            class="btn border-1.5 border-sage bg-sage !px-5 !py-2.5 text-sm text-navy-deep hover:border-paper hover:bg-paper"
          >
            {pied.bouton_contact}
          </a>
          <a
            href={commun.liens.linkedin}
            rel="noopener noreferrer"
            target="_blank"
            class="btn btn-ghost !border-paper/30 !px-5 !py-2.5 text-sm !text-paper/85 hover:!border-sage hover:!text-sage"
          >
            {pied.bouton_linkedin}
          </a>
        </div>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col items-start justify-between gap-2 border-t border-paper/15 pt-6 text-xs text-paper/50 sm:flex-row"
    >
      <p>
        © {year} {pied.copyright}
        {
          pied.liens_legaux.map((l) => (
            <>
              {" · "}
              <a class="lien-legal hover:text-paper" href={href(lienContenu(langue, l.chemin))}>
                {l.label}
              </a>
            </>
          ))
        }
      </p>
      <p>{commun.marque.signature}</p>
    </div>
  </div>
</footer>

<style>
  /*
    Cibles tactiles du pied de page.

    Les liens y sont des lignes de texte de 15 px de haut : au doigt,
    on vise juste. Sur petit écran ils reçoivent la hauteur d'une vraie
    cible — l'espacement de la liste absorbe le supplément, la mise en
    page ne change pas. Au-delà, le pointeur est précis et la densité
    d'origine reprend.
  */
  @media (max-width: 1023px) {
    .lien-pied {
      display: flex;
      align-items: center;
      min-height: 2.75rem;
    }
  }

  /*
    Les mentions légales sont des liens en ligne dans la phrase de
    signature : WCAG 2.5.8 les exempte du minimum de 24 px puisque la
    hauteur de ligne du texte voisin les contraint. On l'atteint tout de
    même : la cible passe de 14 à 26 px de haut.

    Contrairement à un inline pur, c'est la boîte de marge d'un
    inline-block qui fixe la hauteur de la ligne — mesuré, le paragraphe
    de signature grandit de 16 à 26 px. Dix pixels au bas du pied de
    page, sur une ligne seule : sans conséquence de mise en page.
  */
  .lien-legal {
    display: inline-block;
    padding-block: 0.3125rem;
  }
</style>
