---
/**
 * Photographie posée en fond, sans bord.
 *
 * Le parti pris du site : l'image ne s'arrête nulle part. Un masque en
 * dégradé la fait naître au centre et se dissoudre dans le papier, si
 * bien qu'on ne peut pas dire où elle finit. Elle accompagne la colonne
 * de lecture sans jamais la disputer, et n'est pas interactive.
 *
 * Réservée au grand écran : sous 768 px il n'y a pas de colonne libre,
 * elle passerait derrière le texte au lieu de l'équilibrer.
 *
 * Le parent doit être positionné (`relative`) et le contenu qui doit
 * rester lisible placé au-dessus, lui aussi positionné.
 */
interface Props {
  src: string;
  /** De quel côté l'image se loge. */
  cote?: "droite" | "gauche";
  /** Part de la largeur du bloc qu'elle occupe. */
  largeur?: string;
  /**
   * Point de l'image à garder au centre du cadre (`object-position`).
   *
   * La colonne est bien plus haute que large : d'une image carrée, elle
   * n'en montre qu'une bande verticale. Par défaut c'est la bande
   * centrale — quand le sujet est ailleurs, on déplace le cadre au lieu
   * de recadrer le fichier, qui perdrait le reste de la scène.
   */
  cadrage?: string;
  /**
   * Présence de l'image, de 0 à 1.
   *
   * 0.4 convient au papier. Une image très claire sur un aplat sombre
   * demande moins (voir `.visuel-sur-sombre`) ; une image sourde sur un
   * fond gris peut en demander davantage. C'est un réglage d'équilibre,
   * pas une valeur juste : il se juge sur la page, bloc par bloc.
   */
  opacite?: number;
  class?: string;
}

import { href } from "../lib/url";

const {
  src,
  cote = "droite",
  largeur = "46%",
  cadrage = "50% 50%",
  opacite = 0.4,
  class: classe,
} = Astro.props;
---

<div
  class:list={["visuel-fondu", `visuel-${cote}`, classe]}
  style={`--largeur-visuel: ${largeur}; --cadrage-visuel: ${cadrage}; --opacite-visuel: ${opacite}`}
  aria-hidden="true"
>
  <img
    src={href(src)}
    alt=""
    width="1000"
    height="1000"
    loading="lazy"
    decoding="async"
  />
</div>

<style>
  .visuel-fondu {
    position: absolute;
    top: 50%;
    width: var(--largeur-visuel);
    /* Un peu plus haute que le bloc : ses bords fondus doivent en
       sortir, sinon on devine une bande. */
    height: 116%;
    transform: translateY(-50%);
    pointer-events: none;
    z-index: 0;
  }

  /*
    Calée sur le bord du bloc, pas au-delà.

    Elle débordait d'un rem : sans conséquence sur grand écran, où la
    marge du conteneur absorbe le dépassement — mais entre 768 et
    1024 px le conteneur touche presque les bords de la fenêtre, et ce
    rem créait une barre de défilement horizontale (784 px de document
    pour 768 px de fenêtre). Le masque estompe déjà les bords : rien ne
    se perd à s'arrêter là.
  */
  .visuel-droite {
    right: 0;
  }

  .visuel-gauche {
    left: 0;
  }

  .visuel-fondu img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--cadrage-visuel, 50% 50%);
    opacity: var(--opacite-visuel, 0.4);
    /*
      Filtre allégé le 30/07/2026, après mesure.

      `saturate(0.6) contrast(0.95)` écrasait l'image bien plus que son
      opacité : au même point du bloc, l'étendue des valeurs passait de
      195 à 10 selon que le filtre était appliqué ou non. Monter
      l'opacité ne changeait donc presque rien — c'était le filtre, et
      non la transparence, qui rendait la photographie fantomatique.

      Une désaturation légère suffit à l'empêcher de crier ; le contraste
      remonte au-dessus de 1 pour que la matière reste lisible sous le
      masque.
    */
    filter: saturate(0.85) contrast(1.08);
    mask-composite: intersect;
    -webkit-mask-composite: source-in;
  }

  /* Le masque est dissymétrique : franc du côté du texte, plus doux du
     côté du bord de page. */
  .visuel-droite img {
    mask-image:
      linear-gradient(
        to right,
        transparent 0%,
        rgb(0 0 0 / 0.25) 26%,
        #000 62%,
        rgb(0 0 0 / 0.6) 92%,
        transparent 100%
      ),
      linear-gradient(
        to bottom,
        transparent 0%,
        #000 26%,
        #000 72%,
        transparent 100%
      );
  }

  .visuel-gauche img {
    mask-image:
      linear-gradient(
        to left,
        transparent 0%,
        rgb(0 0 0 / 0.25) 26%,
        #000 62%,
        rgb(0 0 0 / 0.6) 92%,
        transparent 100%
      ),
      linear-gradient(
        to bottom,
        transparent 0%,
        #000 26%,
        #000 72%,
        transparent 100%
      );
  }

  /*
    Sur un aplat sombre, une photographie claire ressort beaucoup plus
    que sur le papier : à la même opacité elle passait du fond au sujet.
    On la retient, et `luminosity` lui fait emprunter la teinte du bloc
    au lieu d'y poser ses propres couleurs — l'image devient une matière,
    pas une illustration.

    Classe posée par l'appelant (`class="visuel-sur-sombre"`), donc
    `:global` : les styles d'un composant Astro sont portés par ses
    propres éléments, et celui-ci ne connaît pas le fond qui l'accueille.
  */
  :global(.visuel-sur-sombre) img {
    /* Le fond sombre plafonne la présence de l'image : la valeur passée
       en prop y serait presque toujours trop haute. */
    opacity: 0.22;
    mix-blend-mode: luminosity;
  }

  @media (max-width: 767px) {
    .visuel-fondu {
      display: none;
    }
  }
</style>
