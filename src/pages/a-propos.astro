---
import Base from "../layouts/Base.astro";
import { href } from "../lib/url";
import { aPropos, commun } from "../lib/contenu";
import { enrichir } from "../lib/texte";

const { seo, entete, intro, fondateur, engagement } = aPropos;
---

<Base
  title={seo.titre}
  description={seo.description}
  typePage="AboutPage"
  fil={[{ label: "À propos", chemin: "/a-propos" }]}
>
  <section
    id="pacivis-academy"
    class="cible-ancre relative mx-auto max-w-6xl px-6 pt-16 md:pt-24"
  >
    {/*
      L'emblème tient la colonne de droite.

      Le texte de ce bloc est long et étroit : la moitié droite de la
      page restait vide, alors que le bloc du fondateur, juste en
      dessous, est équilibré par son portrait. On répond par la marque
      elle-même — c'est d'elle que parle la section — traitée comme un
      filigrane et non comme une illustration : le même geste que sur
      l'accueil, avec le dégradé qui l'efface du côté du texte pour
      qu'aucune ligne ne repose sur une trame.

      Il ne descend pas sous 768 px : il n'y a plus de colonne libre,
      il passerait derrière la lecture.
    */}
    <img
      src={href("/logo-400.webp")}
      alt=""
      width="420"
      height="420"
      aria-hidden="true"
      loading="lazy"
      class="embleme"
    />
    <p class="eyebrow relative">{entete.surtitre}</p>
    <h1 class="display relative mt-4 max-w-3xl text-4xl text-navy-deep md:text-5xl">
      {entete.titre}
    </h1>
    <p
      class="relative mt-6 max-w-3xl text-lg leading-relaxed text-ink"
      set:html={enrichir(entete.texte)}
    />
    <div class="relative mt-6 max-w-3xl space-y-4" data-reveal-group>
      {
        intro.map((p) => (
          <p
            class="leading-relaxed text-ink-soft"
            data-reveal
            set:html={enrichir(p)}
          />
        ))
      }
    </div>
  </section>

  {/*
    Séparation des deux blocs. Ils s'enchaînaient sur le même papier,
    sans rien pour dire que l'on passe de la structure à l'homme.

    Le filet est celui de « Notre approche » : même tracé de la gauche
    vers la droite à la révélation, même dégradé qui s'éteint. Le site
    n'invente pas un objet de plus pour chaque page.
  */}
  <div class="mx-auto max-w-6xl px-6 pt-14 md:pt-16">
    <span class="bloc-filet" aria-hidden="true" data-reveal></span>
  </div>

  <!-- Le fondateur : texte à gauche, portrait à droite -->
  <section id="fabien-lacombe" class="cible-ancre mx-auto max-w-6xl px-6 pt-10 pb-16 md:pt-12 md:pb-20">
    <div
      class="grid items-start gap-10 md:grid-cols-[1fr_auto] md:gap-14"
      data-reveal-group
    >
      <div data-reveal>
        <p class="eyebrow">{fondateur.surtitre}</p>
        <h2 class="display mt-4 text-3xl text-navy-deep md:text-4xl">
          {fondateur.titre}
        </h2>
        <div class="mt-6 max-w-2xl space-y-4">
          {
            fondateur.paragraphes.map((p) => (
              <p
                class="leading-relaxed text-ink-soft"
                set:html={enrichir(p)}
              />
            ))
          }
        </div>
      </div>
      {/*
        La couleur revient depuis le visage.

        Deux fois la même image : celle du dessous est virée sépia, dans
        les bruns du papier ; celle du dessus a ses couleurs d'origine
        et se découvre par un cercle qui s'ouvre depuis le regard de
        Fabien. Un filtre seul ne saurait que virer l'image entière
        d'un bloc — c'est le masque qui donne un foyer au retour des
        couleurs.

        Le fichier est le même : le navigateur ne le télécharge qu'une
        fois. Voir `[data-portrait-foyer]` dans global.css. Le cadre
        sauge, lui, continue de se tracer — c'est la signature.
      */}
      <div
        class="relative mx-auto w-60 md:mx-0 md:w-72"
        data-portrait
        data-portrait-foyer
        data-reveal
      >
        <span class="portrait-cadre" aria-hidden="true"></span>
        <div class="portrait-pile relative">
          <img
            src={href("/fabien.webp")}
            alt=""
            aria-hidden="true"
            width="640"
            height="800"
            class="portrait-sepia aspect-4/5 w-full rounded-[6px] object-cover object-[50%_30%]"
          />
          <img
            src={href("/fabien.webp")}
            alt={commun.photos.portrait_alt}
            width="640"
            height="800"
            class="portrait-net aspect-4/5 w-full rounded-[6px] object-cover object-[50%_30%]"
          />
        </div>
      </div>
    </div>
  </section>

  <section id="notre-engagement" class="cible-ancre border-y border-ink/10 bg-paper-deep/60">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
      <p class="eyebrow">{engagement.surtitre}</p>
      <h2 class="display mt-4 max-w-2xl text-3xl text-navy-deep">
        {engagement.titre}
      </h2>
      <div class="mt-6 max-w-2xl space-y-4">
        {
          engagement.paragraphes.map((p) => (
            <p class="leading-relaxed text-ink-soft" set:html={enrichir(p)} />
          ))
        }
      </div>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href={href("/contact")} class="btn btn-primary">
          {engagement.bouton_contact}
        </a>
        <a
          href={commun.liens.linkedin}
          rel="noopener noreferrer"
          target="_blank"
          class="btn btn-ghost"
        >
          {engagement.bouton_linkedin}
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /*
    L'emblème de la section « Pacivis Academy ».

    Posé à droite, centré sur la hauteur du bloc, il est volontairement
    grand : à taille modeste il aurait l'air d'une vignette oubliée.
    Le dégradé l'efface complètement du côté du texte.
  */
  .embleme {
    position: absolute;
    top: 52%;
    right: 1rem;
    width: 22rem;
    height: 22rem;
    transform: translateY(-50%);
    opacity: 0.1;
    pointer-events: none;
    user-select: none;
    mask-image: linear-gradient(to left, #000 34%, transparent 88%);
    -webkit-mask-image: linear-gradient(to left, #000 34%, transparent 88%);
  }

  @media (min-width: 1280px) {
    .embleme {
      width: 26rem;
      height: 26rem;
      right: 3rem;
    }
  }

  @media (max-width: 767px) {
    .embleme {
      display: none;
    }
  }
</style>
