---
import Base from "../layouts/Base.astro";
import { href } from "../lib/url";
import { aPropos, commun } from "../lib/contenu";
import { enrichir } from "../lib/texte";

const { seo, entete, intro, fondateur, engagement } = aPropos;
---

<Base
  title={seo.titre}
  description={seo.description}
  typePage="AboutPage"
  fil={[{ label: "À propos", chemin: "/a-propos" }]}
>
  <section class="mx-auto max-w-6xl px-6 pt-16 md:pt-24">
    <p class="eyebrow">{entete.surtitre}</p>
    <h1 class="display mt-4 max-w-3xl text-4xl text-navy-deep md:text-5xl">
      {entete.titre}
    </h1>
    <p
      class="mt-6 max-w-3xl text-lg leading-relaxed text-ink"
      data-mots
      set:html={enrichir(entete.texte)}
    />
    <div class="mt-6 max-w-3xl space-y-4" data-reveal-group>
      {
        intro.map((p) => (
          <p
            class="leading-relaxed text-ink-soft"
            data-reveal
            set:html={enrichir(p)}
          />
        ))
      }
    </div>
  </section>

  <!-- Le fondateur : texte à gauche, portrait à droite -->
  <section class="mx-auto max-w-6xl px-6 py-16 md:py-20">
    <div
      class="grid items-start gap-10 md:grid-cols-[1fr_auto] md:gap-14"
      data-reveal-group
    >
      <div data-reveal>
        <p class="eyebrow">{fondateur.surtitre}</p>
        <h2 class="display mt-4 text-3xl text-navy-deep md:text-4xl">
          {fondateur.titre}
        </h2>
        <div class="mt-6 max-w-2xl space-y-4">
          {
            fondateur.paragraphes.map((p) => (
              <p
                class="leading-relaxed text-ink-soft"
                set:html={enrichir(p)}
              />
            ))
          }
        </div>
      </div>
      <div class="relative mx-auto w-60 md:mx-0 md:w-72" data-portrait data-reveal>
        <span class="portrait-cadre" aria-hidden="true"></span>
        <img
          src={href("/fabien.webp")}
          alt={commun.photos.portrait_alt}
          width="640"
          height="800"
          class="relative aspect-4/5 w-full rounded-[6px] object-cover object-[50%_30%]"
        />
      </div>
    </div>
  </section>

  <section class="border-y border-ink/10 bg-paper-deep/60">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
      <p class="eyebrow">{engagement.surtitre}</p>
      <h2 class="display mt-4 max-w-2xl text-3xl text-navy-deep">
        {engagement.titre}
      </h2>
      <div class="mt-6 max-w-2xl space-y-4">
        {
          engagement.paragraphes.map((p) => (
            <p class="leading-relaxed text-ink-soft" set:html={enrichir(p)} />
          ))
        }
      </div>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href={href("/contact")} class="btn btn-primary">
          {engagement.bouton_contact}
        </a>
        <a
          href={commun.liens.linkedin}
          rel="noopener noreferrer"
          target="_blank"
          class="btn btn-ghost"
        >
          {engagement.bouton_linkedin}
        </a>
      </div>
    </div>
  </section>
</Base>
