---
import Base from "../layouts/Base.astro";
import DeescalationLine from "../components/DeescalationLine.astro";
import Picto from "../components/Picto.astro";
import { href } from "../lib/url";
import { accueil, commun } from "../lib/contenu";
import { enrichir } from "../lib/texte";
import { getCollection } from "astro:content";

const articles = (await getCollection("journal"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const nomsFlux: Record<string, string> = {
  "revue-litteraire": "Revue littéraire",
  "point-de-vue-actu": "Point de vue actu",
  "terrain-et-pratiques": "Terrain & pratiques",
  "methodes-et-reperes": "Méthodes & repères",
};
---

<Base title={accueil.seo.titre} description={accueil.seo.description}>
  <!-- ============ Hero ============ -->
  <section class="hero-section relative overflow-hidden">
    {/*
      Le logo en filigrane, toujours ancré au MÊME endroit : le coin
      supérieur droit. Seules sa taille et la part qui sort du cadre
      varient avec la largeur — il ne change jamais de place, sans quoi
      on le voit sauter en redimensionnant. Il déborde par le haut,
      dans la bande libre au-dessus du surtitre, et s'estompe du côté
      de la colonne de lecture.
    */}
    <img
      src={href("/logo-400.webp")}
      alt=""
      width="420"
      height="420"
      aria-hidden="true"
      class="logo-filigrane pointer-events-none absolute top-[-5rem] right-[-2.5rem] h-32 w-32 opacity-[0.11] select-none sm:top-[-4rem] sm:right-[-3.5rem] sm:h-52 sm:w-52 md:top-[-4rem] md:right-[-5rem] md:h-72 md:w-72 lg:h-88 lg:w-88 xl:top-[-5rem] xl:right-[-8rem] xl:h-120 xl:w-120"
    />
    <div class="mx-auto max-w-6xl px-6 pt-14 pb-8 sm:pt-20 md:pt-28 md:pb-10">
      <p class="eyebrow reveal reveal-1">{accueil.hero.surtitre}</p>
      <h1
        class="display reveal reveal-2 mt-4 max-w-3xl text-[2.6rem] text-navy-deep sm:text-5xl md:mt-5 md:text-[4.4rem]"
        data-hero-titre
        set:html={enrichir(accueil.hero.titre)}
      />
      <p
        class="reveal reveal-3 mt-5 max-w-xl text-lg leading-relaxed text-ink-soft md:mt-7"
        set:html={enrichir(accueil.hero.texte)}
      />
      <div class="reveal reveal-4 mt-7 flex flex-wrap gap-4 md:mt-9">
        <a href={href("/formations")} class="btn btn-primary">
          {accueil.hero.bouton_principal}
          <span aria-hidden="true">→</span>
        </a>
        <a href={href("/approche")} class="btn btn-ghost">
          {accueil.hero.bouton_secondaire}
        </a>
      </div>
    </div>
    <div class="mx-auto max-w-6xl px-6">
      <DeescalationLine class="h-12 sm:h-16 md:h-24" />
    </div>
  </section>

  <!-- ============ Repères ============ -->
  <section class="border-y border-ink/10 bg-paper-deep/60">
    <div class="mx-auto max-w-6xl px-6 py-12" data-reveal-group>
      <p class="eyebrow" data-reveal>{accueil.reperes.surtitre}</p>
      <ul class="mt-6 max-w-3xl space-y-4">
        {
          accueil.reperes.liste.map((r) => (
            <li
              class="border-l-2 border-sage/50 pl-5 leading-relaxed text-ink-soft"
              data-reveal
              set:html={enrichir(r)}
            />
          ))
        }
      </ul>
      <a
        href={href("/a-propos")}
        class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-sage-deep hover:text-navy-deep"
        data-reveal
      >
        {accueil.reperes.lien} <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- ============ Publics ============ -->
  <section
    class="mx-auto max-w-6xl px-6 py-20"
    data-reveal-group
    data-reveal-stagger="50"
  >
    <div class="grid gap-12 md:grid-cols-[45fr_55fr] md:gap-16">
      <div>
        <p class="eyebrow" data-reveal>{accueil.publics.surtitre}</p>
        <h2
          class="display mt-4 max-w-2xl text-3xl text-navy-deep md:text-4xl"
          data-reveal
        >
          {accueil.publics.titre}
        </h2>
        <p
          class="mt-5 max-w-xl text-ink-soft"
          data-reveal
          set:html={enrichir(accueil.publics.texte)}
        />
      </div>
      <ul class="grid grid-cols-1 content-center gap-4 sm:grid-cols-2">
        {
          accueil.publics.liste.map((p) => (
            <li data-reveal>
              <a
                href={href(p.chemin)}
                class="card group flex h-full flex-col p-6"
              >
                <Picto nom={p.picto} />
                <span class="display mt-3 text-lg leading-snug text-navy-deep">
                  {p.label}
                </span>
                <span class="mt-1.5 flex-1 text-sm leading-snug text-ink-soft">
                  {p.texte}
                </span>
                <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-sage-deep">
                  <span
                    aria-hidden="true"
                    class="transition-transform duration-200 group-hover:translate-x-1"
                  >
                    →
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ Méthode : 4 piliers ============ -->
  <section class="bg-abysse text-paper">
    <div class="mx-auto max-w-6xl px-6 py-20 md:py-24">
      <p class="eyebrow !text-sage" data-reveal>{accueil.methode.surtitre}</p>
      <h2 class="display mt-4 max-w-2xl text-3xl md:text-4xl" data-reveal>
        {accueil.methode.titre}
      </h2>
      <div class="mt-14 grid gap-x-12 gap-y-12 sm:grid-cols-2" data-reveal-group>
        {
          accueil.methode.piliers.map((p) => (
            <div class="group border-t border-paper/15 pt-6" data-reveal>
              <div class="flex items-start justify-between gap-4">
                <h3 class="display text-2xl">{p.titre}</h3>
                <span class="display text-6xl leading-[0.85] text-sage/25 transition-colors duration-300 group-hover:text-sage/50">
                  {p.numero}
                </span>
              </div>
              <p class="mt-3 max-w-md text-[0.95rem] leading-relaxed text-paper/70">
                {p.texte}
              </p>
            </div>
          ))
        }
      </div>
      <p
        class="mt-14 border-l-2 border-sage pl-5 text-lg leading-relaxed text-paper md:max-w-2xl"
        data-mots
        set:html={enrichir(accueil.methode.citation, "text-sage")}
      />
    </div>
  </section>

  <!-- ============ Spotlight PAXI ============ -->
  <section class="mx-auto max-w-6xl px-6 pt-20">
    <a
      href={href("/formations/paxi")}
      class="group flex flex-col gap-4 rounded-2xl bg-abysse p-8 text-paper shadow-(--shadow-card) transition-transform duration-300 hover:-translate-y-0.5 md:flex-row md:items-center md:justify-between md:p-10"
      data-reveal
    >
      <div>
        <p class="eyebrow !text-sage">{accueil.paxi.surtitre}</p>
        <h2 class="display mt-2 max-w-2xl text-2xl md:text-3xl">
          {accueil.paxi.titre}
        </h2>
        <p class="mt-3 max-w-2xl text-[0.95rem] leading-relaxed text-paper/75">
          {accueil.paxi.texte}
        </p>
      </div>
      <span
        class="btn shrink-0 self-start border-1.5 border-sage bg-sage !px-6 text-abysse group-hover:border-paper group-hover:bg-paper md:self-center"
      >
        {accueil.paxi.bouton}
        <span aria-hidden="true">→</span>
      </span>
    </a>
  </section>

  <!-- ============ À propos teaser ============ -->
  <section class="border-y border-ink/10 bg-paper-deep/60">
    <div
      class="mx-auto grid max-w-6xl items-center gap-10 px-6 py-20 md:grid-cols-[auto_1fr] md:gap-16"
      data-reveal-group
    >
      <div
        class="relative mx-auto w-60 md:w-80"
        data-portrait
        data-portrait-directional
        data-reveal
      >
        <span class="portrait-cadre" aria-hidden="true"></span>
        <span class="portrait-direction" aria-hidden="true"></span>
        <img
          src={href("/fabien.webp")}
          alt={commun.photos.portrait_alt}
          width="640"
          height="800"
          class="relative aspect-4/5 w-full rounded-[6px] object-cover object-[50%_30%]"
        />
      </div>
      <div data-portrait-copy data-reveal>
        <p class="portrait-copy-step portrait-copy-kicker eyebrow">
          {accueil.formateur.surtitre}
        </p>
        <h2
          class="portrait-copy-step portrait-copy-title display mt-4 max-w-2xl text-3xl text-navy-deep md:text-4xl"
        >
          {accueil.formateur.titre}
        </h2>
        <p
          class="portrait-copy-step portrait-copy-body mt-5 max-w-2xl leading-relaxed text-ink-soft"
          set:html={enrichir(accueil.formateur.texte)}
        />
        <a
          href={href("/a-propos")}
          class="portrait-copy-step portrait-copy-action btn btn-ghost mt-8"
        >
          {accueil.formateur.bouton}
        </a>
      </div>
    </div>
  </section>

  <!-- ============ Teaser Journal ============ -->
  <section class="mx-auto max-w-6xl px-6 py-20" data-reveal-group>
    <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
      <div>
        <p class="eyebrow">{accueil.journal.surtitre}</p>
        <h2 class="display mt-4 text-3xl text-navy-deep md:text-4xl">
          {accueil.journal.titre}
        </h2>
      </div>
      <a href={href("/journal")} class="btn btn-ghost">
        {accueil.journal.bouton_tous} <span aria-hidden="true">→</span>
      </a>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        articles.map((article) => (
          <a
            href={href(`/journal/${article.id}`)}
            class="card group flex flex-col p-7"
            data-reveal
          >
            <span class="self-start rounded-full bg-sage-faint px-3 py-1 text-xs font-semibold text-sage-deep">
              {nomsFlux[article.data.flux]}
            </span>
            <h3 class="display mt-4 flex-1 text-lg leading-snug text-navy-deep">
              {article.data.titre}
            </h3>
            <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-sage-deep">
              Lire
              <span
                aria-hidden="true"
                class="transition-transform duration-200 group-hover:translate-x-1"
              >
                →
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ============ CTA final ============ -->
  <section class="mx-auto max-w-6xl px-6 py-24" data-reveal-group>
    <h2
      class="display max-w-2xl text-4xl text-navy-deep md:text-5xl"
      data-reveal
    >
      {accueil.appel_final.titre}
    </h2>
    <p
      class="mt-5 max-w-xl text-ink-soft"
      data-reveal
      set:html={enrichir(accueil.appel_final.texte)}
    />
    <a href={href("/contact")} class="btn btn-primary mt-9" data-reveal>
      {accueil.appel_final.bouton} <span aria-hidden="true">→</span>
    </a>
  </section>
</Base>

<style>
  /*
    Le filigrane du logo s'efface progressivement vers la gauche : côté
    texte il a totalement disparu, côté marge il reste visible. Le titre
    ne repose donc jamais sur une trame.
  */
  .logo-filigrane {
    -webkit-mask-image: linear-gradient(to left, black 30%, transparent 85%);
    mask-image: linear-gradient(to left, black 30%, transparent 85%);
  }
</style>
