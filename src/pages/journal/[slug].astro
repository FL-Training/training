---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { href } from "../../lib/url";
import { commun } from "../../lib/contenu";
import { tempsDeLecture } from "../../lib/texte";
import { nomLabel, ordonnerLabels } from "../../lib/labels";
import { nomFlux } from "../../lib/flux";
import { racineSite, urlAbsolue } from "../../lib/seo";

export async function getStaticPaths() {
  const articles = await getCollection("journal");
  return articles.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Estimé sur le markdown source : aucune saisie, et la valeur suit
// automatiquement les relectures de Fabien.
const minutes = tempsDeLecture(entry.body ?? "");

const formatDate = new Intl.DateTimeFormat("fr-FR", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const racine = racineSite(Astro.site!, import.meta.env.BASE_URL);
const noeudsSeo = [
  {
    "@type": "Article",
    "@id": `${new URL(Astro.url.pathname, Astro.site).href}#article`,
    headline: entry.data.titre,
    description: entry.data.resume,
    datePublished: entry.data.date.toISOString().slice(0, 10),
    author: { "@id": `${racine}#fabien-lacombe` },
    publisher: { "@id": `${racine}#organization` },
    mainEntityOfPage: urlAbsolue(Astro.site!, Astro.url.pathname),
    articleSection: nomFlux(entry.data.flux),
    inLanguage: "fr-FR",
  },
];
---

<Base
  title={entry.data.titre}
  description={entry.data.resume}
  fil={[
    { label: "Le Journal", chemin: "/journal" },
    { label: entry.data.titre, chemin: `/journal/${entry.id}` },
  ]}
  noeudsSeo={noeudsSeo}
>
  <article class="mx-auto max-w-3xl px-6 pt-14 pb-20 md:pt-20">
    <a
      href={href("/journal")}
      class="inline-flex items-center gap-2 text-sm font-semibold text-sage-deep hover:text-navy-deep"
    >
      <span aria-hidden="true">←</span> Le Journal
    </a>

    <div class="mt-8 flex flex-wrap items-center gap-3 text-xs">
      <span
        class="rounded-full bg-sage-faint px-3 py-1 font-semibold text-sage-deep"
      >
        {nomFlux(entry.data.flux)}
      </span>
      <time
        datetime={entry.data.date.toISOString().slice(0, 10)}
        class="text-ink-faint"
      >
        {formatDate.format(entry.data.date)}
      </time>
      <span class="text-ink-faint">· {entry.data.auteur}</span>
      <span class="text-ink-faint">
        · {minutes}&nbsp;{commun.journal.duree_lecture}
      </span>
    </div>

    <h1 class="display mt-4 text-3xl text-navy-deep md:text-[2.8rem]">
      {entry.data.titre}
    </h1>
    <p class="mt-5 text-lg leading-relaxed text-ink-soft">
      {entry.data.resume}
    </p>

    {/*
      Les labels renvoient au Journal déjà filtré : c'est le même
      mécanisme que n'importe quel autre lien du site pourra utiliser.
    */}
    {
      entry.data.labels.length > 0 && (
        <ul class="mt-6 flex flex-wrap items-baseline gap-x-1 gap-y-1">
          {ordonnerLabels(entry.data.labels).map((id) => (
            <li>
              <a href={`${href("/journal")}?label=${id}`} class="lien-label">
                {nomLabel(id)}
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {/*
      La vignette, reprise de la carte du Journal.

      Posée entre l'appareil de tête — rubrique, date, titre, résumé,
      labels — et le corps de l'article : elle referme l'entrée en
      matière et ouvre la lecture. Même traitement que dans la liste :
      pas de cadre, des bords qui se dissolvent dans le papier.

      Facultative : un article sans vignette enchaîne directement sur
      son texte.
    */}
    {
      entry.data.vignette && (
        <figure class="vignette-article" data-reveal>
          <img
            src={href(entry.data.vignette.src)}
            alt={entry.data.vignette.alt}
            width="1200"
            height="675"
            loading="eager"
            decoding="sync"
          />
        </figure>
      )
    }

    <div class="prose-site mt-10">
      <Content />
    </div>

    {
      entry.data.sources.length > 0 && (
        <aside class="mt-12 border-t border-ink/10 pt-6">
          <h2 class="eyebrow">Sources</h2>
          <ul class="mt-3 space-y-1.5 text-sm">
            {entry.data.sources.map((s) => (
              <li>
                <a
                  href={s.url}
                  rel="noopener noreferrer"
                  target="_blank"
                  class="font-medium text-sage-deep underline decoration-sage/40 underline-offset-2 hover:text-navy-deep"
                >
                  {s.titre}
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }

    <div
      class="mt-14 rounded-2xl border border-ink/10 bg-paper-deep/40 p-8 text-center"
    >
      <p class="display text-xl text-navy-deep">
        Ces repères s'entraînent en formation.
      </p>
      <div class="mt-5 flex flex-wrap justify-center gap-3">
        <a href={href("/formations")} class="btn btn-primary !px-6 !py-2.5 text-sm">
          Voir les formations
        </a>
        <a href={href("/approche")} class="btn btn-ghost !px-6 !py-2.5 text-sm">
          Notre approche
        </a>
      </div>
    </div>
  </article>
</Base>

<style>
  /*
    LA VIGNETTE DE L'ARTICLE.

    Reprise de la carte du Journal, à pleine largeur de la colonne de
    lecture. Sans cadre : ses bords se dissolvent dans le papier, comme
    tous les visuels du site — une photographie encadrée aurait ici
    l'air d'une pièce rapportée entre le chapô et le texte.

    Elle n'est pas décorative : c'est l'image de l'article, elle porte
    donc son texte de remplacement et vit dans une <figure>.
  */
  .vignette-article {
    margin-top: 2.5rem;
    aspect-ratio: 16 / 7.5;
    overflow: hidden;
  }

  .vignette-article img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.88;
    filter: saturate(0.9) contrast(0.97);
    mask-image: radial-gradient(
      ellipse 50% 50% at 50% 50%,
      #000 0%,
      rgb(0 0 0 / 0.97) 34%,
      rgb(0 0 0 / 0.86) 52%,
      rgb(0 0 0 / 0.62) 68%,
      rgb(0 0 0 / 0.32) 82%,
      rgb(0 0 0 / 0.1) 92%,
      transparent 100%
    );
  }

  /*
    Labels de l'article : des mots cliquables, pas des boutons. Ils
    renvoient au Journal filtré sur ce label. Même langage que la rangée
    de filtres du Journal — un cadre par étiquette alourdissait le haut
    de l'article, juste sous le titre.
  */
  .lien-label {
    display: inline-block;
    padding: 0.2rem 0.55rem;
    border-radius: 0.45rem;
    font-size: 0.82rem;
    color: var(--color-ink-faint);
    transition:
      color 200ms ease,
      background-color 200ms ease;
  }

  .lien-label:hover,
  .lien-label:focus-visible {
    color: var(--color-sage-deep);
    background: var(--color-sage-faint);
  }

  @media (prefers-reduced-motion: reduce) {
    .lien-label {
      transition: none;
    }
  }
</style>
