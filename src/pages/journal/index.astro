---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { href } from "../../lib/url";
import { commun } from "../../lib/contenu";
import { tempsDeLecture } from "../../lib/texte";
import { LABELS, nomLabel, ordonnerLabels } from "../../lib/labels";
import { FLUX, nomFlux } from "../../lib/flux";

const articles = (await getCollection("journal")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

// Seuls les labels réellement portés par un article, dans l'ordre de la
// taxonomie : proposer un filtre vide serait une impasse.
const comptesParLabel = new Map<string, number>();
for (const a of articles) {
  for (const id of a.data.labels) {
    comptesParLabel.set(id, (comptesParLabel.get(id) ?? 0) + 1);
  }
}
const labelsPresents = LABELS.filter((l) => comptesParLabel.has(l.id)).map(
  (l) => l.id,
);

/*
  Les quatre flux de l'architecture V2 sont TOUJOURS proposés, même
  ceux qui n'ont pas encore d'article : ce sont les rubriques de la
  ligne éditoriale validée par Fabien, pas une liste déduite du contenu
  publié. N'afficher que les flux utilisés faisait disparaître « Revue
  littéraire » et « Point de vue actu », et donnait à croire que le
  Journal n'avait que deux entrées.

  Ceux qui sont vides sont visuellement en retrait et non cliquables :
  la promesse éditoriale se voit, sans envoyer le lecteur dans une
  liste vide.
*/
const comptesParFlux = new Map<string, number>();
for (const a of articles) {
  comptesParFlux.set(a.data.flux, (comptesParFlux.get(a.data.flux) ?? 0) + 1);
}

const formatDate = new Intl.DateTimeFormat("fr-FR", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Base
  title="Le Journal Pacivis"
  description="Articles de fond sur la prévention et la gestion des conflits : méthodes, repères, terrain et points de vue — par Fabien Lacombe."
  typePage="CollectionPage"
  fil={[{ label: "Le Journal", chemin: "/journal" }]}
>
  <section class="mx-auto max-w-6xl px-6 pt-16 pb-20 md:pt-24">
    <p class="eyebrow">Le Journal Pacivis</p>
    <h1 class="display mt-4 max-w-3xl text-4xl text-navy-deep md:text-5xl">
      Comprendre avant d'agir.
    </h1>
    <p class="mt-6 max-w-2xl leading-relaxed text-ink-soft">
      Méthodes, repères, retours de terrain et points de vue : des articles de
      fond pour celles et ceux qui font face au conflit dans leur métier.
    </p>

    {/*
      Deux dimensions qui se croisent, et qui ne pèsent pas pareil :

      — le FLUX est la rubrique éditoriale, fixée par l'architecture V2.
        Quatre entrées, stables : c'est une navigation. Elle reprend donc
        le vocabulaire du menu principal — onglets soulignés — et non des
        pastilles.

      — le LABEL est le sujet de l'article. Il y en a davantage, la liste
        grandira, et ce n'est qu'un affinage. Traité en mots légers, sans
        cadre, il s'efface derrière les onglets au lieu de les concurrencer.

      Les deux rangées de gélules identiques, avec deux boutons « Tous »
      côte à côte, mettaient ces deux niveaux sur le même plan et
      saturaient le haut de page.
    */}
    <div class="mt-12" id="filtres-journal">
      <div
        class="flex flex-wrap items-end gap-x-7 gap-y-2 border-b border-ink/10"
        role="group"
        aria-label="Filtrer par flux"
      >
        <button type="button" data-filtre="tous" class="onglet-flux onglet-actif">
          Tous
        </button>
        {
          /*
            Les quatre rubriques sont cliquables, y compris celles qui
            n'ont pas encore d'article : le sous-menu du site y mène
            directement, la page doit donc savoir les afficher. Celles
            qui sont vides restent en retrait et annoncent leur état —
            le lecteur voit qu'elles existent sans croire à un défaut.
          */
          FLUX.map((f) => {
            const nombre = comptesParFlux.get(f.id) ?? 0;
            return (
              <button
                type="button"
                data-filtre={f.id}
                title={
                  nombre > 0
                    ? f.description
                    : `${f.description} Aucun article publié pour le moment.`
                }
                class:list={["onglet-flux", nombre === 0 && "onglet-vide"]}
              >
                {f.nom}
                {nombre === 0 && (
                  <span class="sr-only"> — aucun article pour le moment</span>
                )}
              </button>
            );
          })
        }
      </div>

      {
        labelsPresents.length > 0 && (
          <div
            class="mt-5 flex flex-wrap items-baseline gap-x-1 gap-y-2"
            role="group"
            aria-label="Filtrer par label"
          >
            <span class="mr-2 text-[0.68rem] font-semibold tracking-[0.14em] text-ink-faint uppercase">
              Labels
            </span>
            <button type="button" data-label="tous" class="mot-label mot-actif">
              Tous
            </button>
            {labelsPresents.map((id) => (
              <button type="button" data-label={id} class="mot-label">
                {nomLabel(id)}
                <span class="compte">{comptesParLabel.get(id)}</span>
              </button>
            ))}
          </div>
        )
      }
    </div>

    <p
      id="journal-vide"
      class="mt-10 hidden max-w-2xl border-l-2 border-sage/50 pl-6 leading-relaxed text-ink-soft"
    >
      Aucun article dans cette sélection pour le moment.
    </p>

    <div class="mt-10 grid gap-6 md:grid-cols-2" data-reveal-group>
      {
        articles.map((article) => (
          <a
            href={href(`/journal/${article.id}`)}
            class="card group flex flex-col p-8"
            data-flux={article.data.flux}
            data-labels={article.data.labels.join(" ")}
            data-reveal
          >
            <div class="flex items-center gap-3 text-xs">
              <span class="rounded-full bg-sage-faint px-3 py-1 font-semibold text-sage-deep">
                {nomFlux(article.data.flux)}
              </span>
              <time
                datetime={article.data.date.toISOString().slice(0, 10)}
                class="text-ink-faint"
              >
                {formatDate.format(article.data.date)}
              </time>
              <span class="text-ink-faint">
                · {tempsDeLecture(article.body ?? "")}&nbsp;
                {commun.journal.duree_lecture}
              </span>
            </div>
            <h2 class="display mt-4 text-[1.35rem] leading-snug text-navy-deep">
              {article.data.titre}
            </h2>
            <p class="mt-3 flex-1 text-[0.95rem] leading-relaxed text-ink-soft">
              {article.data.resume}
            </p>
            {/*
              Même langage que la rangée de filtres : des mots, pas des
              boîtes. Sur une carte déjà dense — rubrique, date, durée,
              titre, résumé — des étiquettes encadrées ajoutaient une
              quatrième forme à lire.
            */}
            {article.data.labels.length > 0 && (
              <ul class="mt-4 flex flex-wrap items-baseline gap-x-3 gap-y-1 text-[0.76rem] text-ink-faint">
                {ordonnerLabels(article.data.labels).map((id) => (
                  <li class="etiquette">{nomLabel(id)}</li>
                ))}
              </ul>
            )}
            <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-sage-deep">
              Lire l'article
              <span
                aria-hidden="true"
                class="transition-transform duration-200 group-hover:translate-x-1"
              >
                →
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <script>
    /*
      Filtrage sur deux dimensions qui se cumulent. Le label sélectionné
      est reflété dans l'URL (`?label=…`) : n'importe quelle page du
      site peut donc pointer vers le Journal déjà filtré, et le lien
      reste partageable. La navigation par l'historique est prise en
      charge, sans quoi le bouton « précédent » laisserait des filtres
      actifs sur une liste qui ne leur correspond plus.
    */
    function initFiltres() {
      const filtres = document.querySelector("#filtres-journal");
      if (!filtres) return;

      const boutonsFlux =
        document.querySelectorAll<HTMLButtonElement>(".onglet-flux");
      const boutonsLabel =
        document.querySelectorAll<HTMLButtonElement>(".mot-label");
      const cartes = document.querySelectorAll<HTMLElement>("[data-flux]");
      const vide = document.querySelector<HTMLElement>("#journal-vide");

      let flux = "tous";
      let label = "tous";

      const activer = (
        boutons: NodeListOf<HTMLButtonElement>,
        attribut: "filtre" | "label",
        valeur: string,
      ) => {
        boutons.forEach((b) => {
          const actif = b.dataset[attribut] === valeur;
          b.classList.toggle(attribut === "filtre" ? "onglet-actif" : "mot-actif", actif);
          b.setAttribute("aria-pressed", String(actif));
        });
      };

      const appliquer = () => {
        let visibles = 0;
        cartes.forEach((carte) => {
          const labels = (carte.dataset.labels ?? "").split(" ");
          const garde =
            (flux === "tous" || carte.dataset.flux === flux) &&
            (label === "tous" || labels.includes(label));
          carte.style.display = garde ? "" : "none";
          if (garde) visibles++;
        });
        vide?.classList.toggle("hidden", visibles > 0);
        activer(boutonsFlux, "filtre", flux);
        activer(boutonsLabel, "label", label);
      };

      // Les deux filtres se lisent dans l'URL : le menu du site et
      // n'importe quel lien peuvent donc ouvrir le Journal sur une
      // rubrique ou un thème précis, et l'adresse reste partageable.
      const lireUrl = () => {
        const params = new URL(window.location.href).searchParams;
        const fluxDemande = params.get("flux");
        const labelDemande = params.get("label");
        const connu = (
          boutons: NodeListOf<HTMLButtonElement>,
          cle: "filtre" | "label",
          valeur: string,
        ) =>
          [...boutons].some((b) => b.dataset[cle] === valeur);

        flux =
          fluxDemande && connu(boutonsFlux, "filtre", fluxDemande)
            ? fluxDemande
            : "tous";
        label =
          labelDemande && connu(boutonsLabel, "label", labelDemande)
            ? labelDemande
            : "tous";
        appliquer();
      };

      const ecrireUrl = () => {
        const url = new URL(window.location.href);
        for (const [cle, valeur] of [
          ["flux", flux],
          ["label", label],
        ]) {
          if (valeur === "tous") url.searchParams.delete(cle);
          else url.searchParams.set(cle, valeur);
        }
        history.replaceState({}, "", url);
      };

      boutonsFlux.forEach((bouton) =>
        bouton.addEventListener("click", () => {
          flux = bouton.dataset.filtre ?? "tous";
          appliquer();
          ecrireUrl();
        }),
      );

      boutonsLabel.forEach((bouton) =>
        bouton.addEventListener("click", () => {
          label = bouton.dataset.label ?? "tous";
          appliquer();
          ecrireUrl();
        }),
      );

      window.addEventListener("popstate", lireUrl);
      lireUrl();
    }
    document.addEventListener("astro:page-load", initFiltres);
  </script>
</Base>

<style>
  /*
    FLUX — la rubrique éditoriale. Même geste que le menu principal :
    un mot, un filet vert dessous quand il est actif. Aucune gélule, pour
    que cette rangée se lise comme une navigation et non comme une
    collection d'étiquettes.
  */
  .onglet-flux {
    padding-bottom: 0.65rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-ink-soft);
    border-bottom: 2px solid transparent;
    /* Le filet part du centre : le mot ne bouge pas d'un pixel quand il
       devient actif. */
    background-image: linear-gradient(
      var(--color-sage-deep),
      var(--color-sage-deep)
    );
    background-repeat: no-repeat;
    background-position: 50% 100%;
    background-size: 0% 2px;
    transition:
      color 220ms ease,
      background-size 340ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .onglet-flux:hover:not(.onglet-vide) {
    color: var(--color-navy-deep);
    background-size: 40% 2px;
  }

  .onglet-flux.onglet-actif {
    color: var(--color-navy-deep);
    background-size: 100% 2px;
  }

  /* Rubrique annoncée mais pas encore alimentée : présente, en retrait,
     inerte. */
  .onglet-vide {
    color: color-mix(in oklab, var(--color-ink-faint) 65%, transparent);
    cursor: default;
  }

  /*
    LABELS — l'affinage. Des mots, pas des boutons : pas de bordure, une
    surface qui n'apparaît qu'au survol et à la sélection. La rangée
    reste lisible même quand la liste s'allongera.
  */
  .mot-label {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    padding: 0.28rem 0.6rem;
    border-radius: 0.5rem;
    font-size: 0.86rem;
    color: var(--color-ink-faint);
    transition:
      color 200ms ease,
      background-color 200ms ease;
  }

  .mot-label:hover {
    color: var(--color-navy-deep);
    background: color-mix(in oklab, var(--color-ink) 5%, transparent);
  }

  .mot-label.mot-actif {
    color: var(--color-sage-deep);
    background: var(--color-sage-faint);
    font-weight: 600;
  }

  /*
    Étiquettes sur les cartes. Un point médian les sépare — assez pour
    les distinguer, trop peu pour former une rangée d'objets.
  */
  .etiquette + .etiquette::before {
    content: "·";
    margin-inline-end: 0.6rem;
    color: color-mix(in oklab, var(--color-ink-faint) 45%, transparent);
  }

  /* Le nombre d'articles : une indication, jamais un élément de plus à
     lire. Il disparaît sur le bouton « Tous », qui n'en a pas. */
  .compte {
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
    color: color-mix(in oklab, currentColor 55%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .onglet-flux,
    .mot-label {
      transition: none;
    }
  }
</style>
