---
// Titrage lapidaire romain (écho au logo « PACIVIS »), corps en
// grotesque pour la lisibilité des blocs longs et de l'interface.
// Choix ARRÊTÉ le 26/07/2026 : la page de comparaison /typo-essai et
// les polices des autres pistes ont été supprimées.
import "@fontsource/marcellus/400.css";
import "@fontsource-variable/archivo";
/*
  Les deux fichiers de police, réclamés dès la première ligne du <head>.

  Sans cela le navigateur ne les découvre qu'après avoir lu la feuille
  de style, calculé la mise en page et vu qu'un texte les réclame : il
  peint donc une première fois avec la police de secours, puis
  recompose tout quand les vraies arrivent. Les lignes ne se coupent
  plus au même endroit, les mots changent de forme — c'est la
  recomposition visible au chargement d'une page.

  `?url` demande à Vite l'adresse du fichier plutôt que son contenu ;
  elle est hachée au build et reste juste en développement.
*/
import policeTitres from "@fontsource/marcellus/files/marcellus-latin-400-normal.woff2?url";
import policeTexte from "@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url";
import "lenis/dist/lenis.css";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { href } from "../lib/url";
import { commun } from "../lib/contenu";
import { grapheSeo, urlAbsolue } from "../lib/seo";
import type { Fil, TypePage } from "../lib/seo";

interface Props {
  title: string;
  description: string;
  typePage?: TypePage;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  fil?: Fil[];
  noeudsSeo?: Record<string, unknown>[];
}

const {
  title,
  description,
  typePage = "WebPage",
  image = "/og-image.jpg",
  imageAlt = commun.photos.og_alt,
  noindex = false,
  fil,
  noeudsSeo,
} = Astro.props;

const marque = commun.marque.nom;
const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = urlAbsolue(Astro.site!, `${base}${image}`);

const jsonLd = grapheSeo({
  site: Astro.site!,
  base: import.meta.env.BASE_URL,
  pathname: Astro.url.pathname,
  titre: `${title} — ${marque}`,
  description,
  typePage,
  imageUrl,
  fil,
  noeudsSupplementaires: noeudsSeo,
});
---

<!doctype html>
{/*
  `nav-figee` dès le rendu serveur : à l'ouverture d'une page, un
  curseur laissé sur une entrée du bandeau déclencherait `:hover` au
  premier affichage, et un panneau se déplierait sans qu'on l'ait
  demandé. La classe part au premier mouvement du pointeur (script en
  fin de fichier). Écrite ici plutôt qu'ajoutée en JavaScript, elle
  s'applique dès le premier octet — donc aucun panneau n'a le temps de
  s'entrouvrir, y compris quand la page est rechargée entièrement.
*/}
<html lang="fr" class="nav-figee">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Avant tout le reste : voir le commentaire des imports. */}
    <link
      rel="preload"
      href={policeTitres}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={policeTexte}
      as="font"
      type="font/woff2"
      crossorigin
    />
    {/*
      Empreinte de la publication en cours. Sert au diagnostic : en cas
      de doute sur ce que sert le navigateur, cette valeur dit quelle
      version est réellement affichée.
    */}
    {
      import.meta.env.PUBLIC_BUILD_ID && (
        <meta
          name="pacivis-build"
          content={import.meta.env.PUBLIC_BUILD_ID.slice(0, 8)}
        />
      )
    }
    {/*
      Nom court de la page, tel qu'il apparaîtrait dans un fil d'Ariane.
      Le script de parcours s'en sert pour nommer les étapes réellement
      traversées ; sans lui, il ne pourrait afficher que des chemins.
    */}
    <meta
      name="pacivis-page"
      content={fil?.at(-1)?.label ?? title}
    />
    {/*
      Position de la page dans l'arborescence, pour le fil d'Ariane du
      parcours. Sans elle, le fil rendrait l'ordre des visites — « Notre
      approche › Organisme de formation » si le visiteur est passé par
      là — au lieu du chemin réel du site.
    */}
    {fil && fil.length > 0 && (
      <meta
        name="pacivis-hierarchie"
        content={JSON.stringify(
          fil.map((f) => ({ label: f.label, chemin: href(f.chemin) })),
        )}
      />
    )}
    <title>{title} — {marque}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex,follow" />
      ) : (
        <>
          <meta name="robots" content="index,follow,max-image-preview:large" />
          <link rel="canonical" href={canonical} />
        </>
      )
    }
    <link rel="icon" type="image/png" href={href("/favicon.png")} />
    <link rel="apple-touch-icon" href={href("/apple-touch-icon.png")} />
    <link rel="sitemap" href={href("/sitemap-index.xml")} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={marque} />
    <meta property="og:title" content={`${title} — ${marque}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — ${marque}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />

    {/*
      TRANSITIONS DE PAGE — PRODUCTION UNIQUEMENT.

      En développement, le routeur et le rechargement à chaud se
      disputent le contenu du <head>. Séquence reproduite le 26/07 :
      page ouverte, une règle CSS modifiée (le rechargement à chaud
      l'applique correctement), puis une navigation — et la page revient
      à l'ANCIENNE valeur. Le style venait d'être corrigé sous les yeux
      du développeur, et la navigation le défaisait.

      C'est ce qui a fait passer plusieurs fois pour des défauts du site
      des artefacts du serveur de dev : « ça marche quand je rafraîchis,
      pas quand je navigue ».

      En développement, chaque navigation redevient donc un chargement
      complet : ce que l'on voit est toujours l'état réel du code. En
      production il n'y a pas de rechargement à chaud, le routeur reprend
      la main, et `npm run test:styles` vérifie sur le build qu'aucun
      style ne se perd d'une page à l'autre.
    */}
    {!import.meta.env.DEV && <ClientRouter />}

    <script>
      import "../scripts/defilement";
      import "../scripts/effets-scroll";
      import "../scripts/cartes-depliables";
      import "../scripts/ancres";
      import "../scripts/version";
      import "../scripts/parcours";
    </script>

    <script
      is:inline
      define:vars={{
        libelleOuvrir: commun.menu.ouvrir,
        libelleFermer: commun.menu.fermer,
      }}
    >
      // Scroll reveal + navigation progress. Motion is opt-in: without JS
      // (or with prefers-reduced-motion) every element stays visible.
      (() => {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          return;
        }

        let observateur = null;
        /* Les observateurs secondaires, à débrancher au changement de
           page comme le principal. */
        let observateurs = [];

        const init = () => {
          // The ClientRouter swaps <html> attributes on every navigation:
          // the class must be re-applied here, not just at first load.
          document.documentElement.classList.add("js-reveal");
          observateur?.disconnect();
          observateurs.forEach((o) => o.disconnect());
          observateurs = [];

          document.querySelectorAll("[data-reveal-group]").forEach((groupe) => {
            const pas = Number(groupe.dataset.revealStagger) || 70;
            groupe.querySelectorAll("[data-reveal]").forEach((el, i) => {
              el.style.setProperty("--reveal-delay", `${i * pas}ms`);
            });
          });
          const declencher = (entrees, obs) => {
            for (const entree of entrees) {
              if (entree.isIntersecting) {
                entree.target.classList.add("revealed");
                obs.unobserve(entree.target);
              }
            }
          };

          observateur = new IntersectionObserver(declencher, { threshold: 0.18 });

          /*
            Un second regard, plus exigeant, pour ce qui mérite d'être
            regardé.

            Le seuil ordinaire déclenche dès qu'un élément pointe par le
            bas de l'écran : parfait pour un paragraphe qui monte, mais
            pas pour une animation longue. Sur un grand écran, le
            portrait était déjà entré dans le champ au chargement de la
            page — son retour en couleurs se jouait avant même qu'on ait
            défilé, et Fabien ne voyait jamais que le résultat.

            La marge négative rétrécit la fenêtre d'observation à sa
            moitié haute : l'élément doit y être monté pour compter comme
            visible. On voit donc l'animation quand on la regarde.
          */
          const tardif = new IntersectionObserver(declencher, {
            threshold: 0.25,
            rootMargin: "0px 0px -45% 0px",
          });
          observateurs.push(tardif);

          for (const el of document.querySelectorAll(
            "[data-reveal]:not(.revealed)",
          )) {
            (el.hasAttribute("data-reveal-tardif") ? tardif : observateur).observe(el);
          }
        };

        document.addEventListener("astro:page-load", init);

        /*
          EN DÉVELOPPEMENT, PERSONNE N'ANNONCE L'ARRIVÉE DE LA PAGE.

          `astro:page-load` est émis par le routeur — y compris au tout
          premier chargement. Or le routeur est désactivé en
          développement (voir le commentaire du ClientRouter, plus
          haut) : l'événement n'est donc jamais émis, et les huit
          modules qui l'attendent ne s'initialisent pas. Révélations au
          défilement, cartes dépliables, ancres, animation d'ARCA, fil
          d'Ariane : rien ne s'exécutait en local, alors que tout
          fonctionnait sur le site construit. C'est une régression que
          la désactivation du routeur avait introduite sans qu'on la
          voie — un défaut visible seulement là où l'on travaille.

          On émet donc l'événement nous-mêmes si personne ne l'a fait,
          une fois la page complètement chargée : à cet instant tous les
          modules ont été exécutés et ont posé leurs écouteurs.

          La condition porte sur le fait constaté — l'événement est-il
          venu ? — et non sur le mode de compilation : ce script est
          `is:inline`, donc `import.meta` n'y est pas remplacé et le
          navigateur refuserait le fichier entier. En production le
          routeur annonce la page bien avant, et cette reprise ne fait
          rien.
        */
        let annonceRecue = false;
        document.addEventListener(
          "astro:page-load",
          () => {
            annonceRecue = true;
          },
          { once: true },
        );
        const reprendre = () => {
          if (!annonceRecue) document.dispatchEvent(new Event("astro:page-load"));
        };
        if (document.readyState === "complete") setTimeout(reprendre, 0);
        else
          window.addEventListener("load", () => setTimeout(reprendre, 0), {
            once: true,
          });

        /*
          LE SOUS-MENU QUI SE ROUVRE TOUT SEUL.

          Après un clic sur une entrée du bandeau, le pointeur reste
          exactement où il était. La page change, le bandeau est
          reconstruit — et le nouveau lien se retrouve sous un curseur
          immobile : `:hover` s'applique, et le panneau se déplie une
          seconde fois, avec son animation. Mesuré : la page arrive à
          105 ms, le panneau se rouvre à 528 ms. C'est ce déploiement
          non demandé, un demi-instant après l'arrivée, que l'on voit
          comme un défaut de chargement.

          On gèle donc le survol du bandeau le temps de la navigation,
          et on ne le rend qu'au premier vrai mouvement du pointeur —
          c'est-à-dire quand le visiteur redemande quelque chose.
          `:focus-within` n'est pas touché : la tabulation continue
          d'ouvrir les panneaux.
        */
        const degeler = () => {
          document.documentElement.classList.remove("nav-figee");
        };
        const geler = () => {
          document.documentElement.classList.add("nav-figee");
          // `once` : le prochain mouvement rend la main, et rien ne
          // reste branché entre deux navigations.
          window.addEventListener("pointermove", degeler, { once: true });
          window.addEventListener("pointerdown", degeler, { once: true });
        };

        /*
          À reposer après l'échange : le routeur recopie les attributs
          de <html> depuis le document reçu, ce qui efface la classe
          posée avant la navigation.
        */
        document.addEventListener("astro:after-swap", geler);

        // Et au chargement du document : la classe est déjà posée par
        // le rendu serveur, il ne manque que de quoi la retirer.
        geler();

        document.addEventListener("astro:before-preparation", () => {
          geler();
          /*
            La barre de progression n'apparaît que si l'attente est
            réelle. Une navigation interne se règle en ~100 ms : la
            barre montait alors à 8 % de large puis disparaissait —
            un clignotement vert sous le bandeau, à chaque clic, qui
            n'informait de rien.
          */
          const barre = document.querySelector(".nav-progress");
          const differee = window.setTimeout(
            () => barre?.classList.add("actif"),
            180,
          );
          document.addEventListener(
            "astro:after-swap",
            () => {
              window.clearTimeout(differee);
              barre?.classList.remove("actif");
            },
            { once: true },
          );
        });

        // Accessible state of the mobile menu (<details> toggle doesn't
        // bubble: capture phase).
        document.addEventListener(
          "toggle",
          (evenement) => {
            const details = evenement.target;
            if (!(details instanceof HTMLDetailsElement)) return;
            const resume = details.querySelector("summary");
            if (!resume) return;
            resume.setAttribute(
              "aria-label",
              details.open ? libelleFermer : libelleOuvrir,
            );
            resume.setAttribute("aria-expanded", String(details.open));
          },
          true,
        );
      })();
    </script>
  </head>
  <body class="grain flex min-h-screen flex-col">
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-navy focus:px-4 focus:py-2 focus:text-paper"
    >
      Aller au contenu
    </a>
    <Header />
    <main id="contenu" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
