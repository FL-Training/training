---
/**
 * Espace apprenant — rubrique transversale, pas encore ouverte.
 *
 * Le livrable de Fabien est explicite sur deux points que cette page
 * doit tenir : ne jamais laisser croire que l'espace est disponible, et
 * renvoyer vers Contact — non plus vers les formations, comme le
 * faisait la version précédente.
 *
 * Le formulaire de liste d'attente a été retiré : le texte validé n'en
 * prévoit pas, et il proposait implicitement une ouverture imminente.
 * Le composant `WaitlistForm` et sa table Convex restent en place, prêts
 * à resservir si Fabien décide de rouvrir cette collecte.
 */
import Base from "../layouts/Base.astro";
import Picto from "../components/Picto.astro";
import { href } from "../lib/url";
import { contenuLangue, libelleNavigation } from "../lib/contenu";
import { langueActive } from "../lib/langue-active";
import { cheminLangue } from "../lib/routes";

// La langue se lit dans l'adresse : ce composant sert toutes les
// langues publiées, le contenu suit.
const langue = langueActive(Astro.url.pathname);
const { espaceApprenant } = contenuLangue(langue);
import { enrichir } from "../lib/texte";

const { lance, url_skool, seo, entete, contenu, statut } = espaceApprenant;

// Un pictogramme par fonction annoncée, dans l'ordre du contenu.
const PICTOS = ["graduation-cap", "shield-check", "messages-square", "users-round"];
---

<Base
  title={seo.titre}
  description={seo.description}
  fil={[{ label: libelleNavigation(langue, "espace-apprenant"), chemin: cheminLangue(langue, "/espace-apprenant") }]}
>
  <section class="mx-auto max-w-6xl px-6 pt-16 pb-20 md:pt-24">
    <p class="eyebrow">{entete.surtitre}</p>
    <h1 class="display mt-4 max-w-3xl text-4xl text-navy-deep md:text-5xl">
      {entete.titre}
    </h1>
    <div class="mt-6 max-w-3xl space-y-4 text-lg leading-relaxed text-ink-soft">
      {entete.texte.split("\n\n").map((p) => <p set:html={enrichir(p)} />)}
    </div>

    {/*
      Quatre fonctions annoncées, sur deux colonnes : « Partager des
      retours d'expérience » compte deux paragraphes et étoufferait dans
      une grille à trois.
    */}
    <div class="mt-16" data-reveal-group data-reveal-stagger="50">
      <h2 class="display text-2xl text-navy-deep md:text-3xl" data-reveal>
        {contenu.titre}
      </h2>
      <div class="mt-8 grid gap-x-12 gap-y-10 md:grid-cols-2">
        {
          contenu.liste.map((c, i) => (
            <div class="border-t border-ink/15 pt-5" data-reveal>
              <Picto nom={PICTOS[i] ?? "graduation-cap"} />
              <h3 class="display mt-3 text-xl text-navy-deep">{c.titre}</h3>
              <div class="mt-2 space-y-3 text-[0.95rem] leading-relaxed text-ink-soft">
                {c.texte.split("\n\n").map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-16 rounded-2xl bg-abysse p-8 text-paper md:p-12" data-reveal>
      {
        lance && url_skool ? (
          <div>
            <h2 class="display text-2xl md:text-3xl">{statut.bouton_acces}</h2>
            <a
              href={url_skool}
              rel="noopener noreferrer"
              target="_blank"
              class="btn mt-6 border-1.5 border-sage bg-sage !px-8 text-abysse hover:border-paper hover:bg-paper"
            >
              {statut.bouton_acces} <span aria-hidden="true">→</span>
            </a>
          </div>
        ) : (
          <div class="max-w-2xl">
            <h2 class="display text-2xl md:text-3xl">{statut.titre}</h2>
            <div class="mt-3 space-y-3 leading-relaxed text-paper/80">
              {statut.texte.split("\n\n").map((p) => (
                <p>{p}</p>
              ))}
            </div>
            <a
              href={href(cheminLangue(langue, "/contact"))}
              class="btn mt-7 border-1.5 border-sage bg-sage !px-8 text-abysse hover:border-paper hover:bg-paper"
            >
              {statut.bouton_contact} <span aria-hidden="true">→</span>
            </a>
          </div>
        )
      }
    </div>
  </section>
</Base>
