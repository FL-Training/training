---
/**
 * Page PAXI.
 *
 * Suit l'ordre imposé par le livrable de Fabien : ouverture, encart de
 * conformité EASA/IOSA — visuellement distinct et placé AVANT le
 * programme —, programme commun en cinq blocs, deux déclinaisons
 * métiers, pédagogie, contenus adaptables, puis un appel à l'échange
 * unique.
 *
 * La page ne s'organise jamais par type de client : le contexte de la
 * demande est porté par la page d'où vient le visiteur (accueil,
 * Entreprises ou Organismes de formation).
 */
import Base from "../../layouts/Base.astro";
import DeescalationLine from "../../components/DeescalationLine.astro";
import { href } from "../../lib/url";
import { contenuLangue, libelleNavigation } from "../../lib/contenu";
import { texteInterface } from "../../lib/interface";
import { langueActive } from "../../lib/langue-active";
import { localeLangue } from "../../lib/langues";
import { cheminLangue } from "../../lib/routes";

// La langue se lit dans l'adresse : ce composant sert toutes les
// langues publiées, le contenu suit.
const langue = langueActive(Astro.url.pathname);
const { paxi, commun } = contenuLangue(langue);
import { enrichir } from "../../lib/texte";
import { racineSite } from "../../lib/seo";

const {
  seo,
  entete,
  conformite,
  programme,
  declinaisons,
  pedagogie,
  adaptables,
  cta,
} = paxi;

const racine = racineSite(Astro.site!, import.meta.env.BASE_URL);
const noeudsSeo = [
  {
    "@type": "Course",
    "@id": `${new URL(Astro.url.pathname, Astro.site).href}#course`,
    /*
      Le nom du cours vient du contenu de la langue affichée. Écrit en
      dur, il publiait un nœud `Course` français sous un `inLanguage:
      en-GB` — une donnée structurée qui se contredit elle-même. Le titre
      de référencement porte déjà exactement ce nom, dans chaque langue.
    */
    name: seo.titre,
    description: seo.description,
    provider: { "@id": `${racine}#organization` },
    inLanguage: localeLangue(langue),
    audience: declinaisons.liste.map((d) => ({
      "@type": "Audience",
      audienceType: d.titre,
    })),
  },
];
---

<Base
  title={seo.titre}
  description={seo.description}
  fil={[
    { label: libelleNavigation(langue, "formations"), chemin: cheminLangue(langue, "/formations") },
    { label: "PAXI", chemin: cheminLangue(langue, "/formations/paxi") },
  ]}
  noeudsSeo={noeudsSeo}
>
  <!-- Ouverture -->
  <section class="bg-abysse text-paper">
    <div class="mx-auto max-w-6xl px-6 pt-10 pb-12 md:pt-14">
      {/*
        Le chemin réellement parcouru. PAXI s'atteint depuis trois
        endroits du site : le fil dit d'où l'on vient et permet d'y
        retourner. Le repli ci-dessous — « Accueil › PAXI » — est rendu
        côté serveur, donc juste même sans JavaScript et pour qui arrive
        par un lien direct ; le script y insère les étapes traversées.
      */}
      <nav class="fil-parcours" aria-label={texteInterface(langue, "filAriane")} data-fil-parcours="repli">
        <ol>
          <li><a href={href(cheminLangue(langue, "/"))}>{commun.fil.accueil}</a></li>
          <li aria-current="page">PAXI</li>
        </ol>
      </nav>

      <p class="eyebrow !text-sage mt-8">{entete.surtitre}</p>
      <h1 class="display mt-4 max-w-4xl text-3xl md:text-5xl">
        {entete.titre}
      </h1>
      {
        entete.texte.split("\n\n").map((p) => (
          <p
            class="mt-6 max-w-3xl text-lg leading-relaxed text-paper/85"
            set:html={enrichir(p, "text-sage")}
          />
        ))
      }
      <DeescalationLine class="mt-10 h-12 opacity-60 md:h-16" mode="defilement" />
    </div>
  </section>

  {/*
    Conformité : encart à part entière, pas une phrase du corps de
    texte. C'est la première chose qu'un responsable formation d'une
    compagnie doit pouvoir vérifier.
  */}
  <section class="mx-auto max-w-6xl px-6 pt-14">
    <aside
      class="flex max-w-3xl flex-col gap-3 rounded-2xl border-l-4 border-sage bg-sage-faint/60 px-8 py-7"
      data-reveal
    >
      <h2
        class="text-[0.72rem] font-semibold tracking-[0.18em] text-sage-deep uppercase"
      >
        {conformite.titre}
      </h2>
      <p class="display text-lg leading-snug text-navy-deep md:text-xl">
        {conformite.texte}
      </p>
    </aside>
  </section>

  <!-- Programme commun -->
  <section class="mx-auto max-w-6xl px-6 py-16" data-reveal-group>
    <h2 class="display text-2xl text-navy-deep md:text-3xl" data-reveal>
      {programme.titre}
    </h2>
    <ol class="mt-10 space-y-8">
      {
        programme.liste.map((m, i) => (
          <li
            class="grid gap-4 border-t border-ink/10 pt-6 md:grid-cols-[90px_1fr] md:gap-8"
            data-reveal
          >
            {/*
              sage/60 ne donnait que 1.54:1 sur le fond papier : le numéro
              du module était invisible pour qui voit mal. sage-deep/80
              monte à 3.77:1, au-delà du 3:1 exigé pour du texte large,
              en gardant le chiffre plus léger que le titre qu'il annonce.
            */}
            <span class="display text-4xl text-sage-deep/80 md:text-5xl">
              {String(i + 1).padStart(2, "0")}
            </span>
            <div>
              <h3 class="display text-xl text-navy-deep">{m.titre}</h3>
              <p class="mt-2 max-w-3xl leading-relaxed text-ink-soft">
                {m.texte}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Deux déclinaisons métiers -->
  <section class="border-y border-ink/10 bg-paper-deep/50">
    <div class="mx-auto max-w-6xl px-6 py-16" data-reveal-group>
      <h2 class="display text-2xl text-navy-deep md:text-3xl" data-reveal>
        {declinaisons.titre}
      </h2>
      <div class="mt-10 grid gap-8 md:grid-cols-2">
        {
          declinaisons.liste.map((d) => (
            <div class="card p-8" data-reveal>
              <h3 class="display text-xl text-navy-deep">{d.titre}</h3>
              <div class="mt-4 space-y-3">
                {d.paragraphes.map((p) => (
                  <p class="leading-relaxed text-ink-soft">{p}</p>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Pédagogie -->
  <section class="mx-auto max-w-6xl px-6 py-16" data-reveal-group>
    <h2 class="display max-w-3xl text-2xl text-navy-deep md:text-3xl" data-reveal>
      {pedagogie.titre}
    </h2>
    <div class="mt-6 max-w-3xl space-y-4">
      {
        pedagogie.paragraphes.map((p) => (
          <p class="leading-relaxed text-ink-soft" data-reveal>
            {p}
          </p>
        ))
      }
    </div>
  </section>

  <!-- Contenus adaptables -->
  <section class="border-t border-ink/10">
    <div class="mx-auto max-w-6xl px-6 py-16" data-reveal-group>
      <h2 class="display max-w-3xl text-2xl text-navy-deep md:text-3xl" data-reveal>
        {adaptables.titre}
      </h2>
      <div class="mt-10 space-y-10">
        {
          adaptables.liste.map((a) => (
            <div class="max-w-3xl border-l-2 border-sage/50 pl-6" data-reveal>
              <h3 class="display text-lg text-navy-deep">{a.titre}</h3>
              <p class="mt-3 leading-relaxed text-ink-soft">{a.texte}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/*
    Appel à l'échange unique — le livrable n'en prévoit qu'un pour toute
    la page. Aligné à gauche, comme le reste du site : la charte réserve
    le centrage à la couverture.
  */}
  <section class="mx-auto max-w-6xl px-6 pb-24">
    <div
      class="flex flex-col gap-6 rounded-2xl border border-ink/10 bg-paper-deep/40 p-10 md:flex-row md:items-center md:justify-between"
    >
      <p class="display max-w-2xl text-xl leading-snug text-navy-deep md:text-2xl">
        {cta.texte}
      </p>
      <a
        href={href(cheminLangue(langue, "/contact"))}
        class="btn btn-primary shrink-0 self-start md:self-center"
      >
        {cta.bouton} <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Base>

<style>
  /*
    Fil d'Ariane sur fond sombre : des mots séparés par un chevron
    discret, sans cadre ni fond. Il précède le surtitre et ne doit pas
    lui disputer l'attention.

    ⚠️ `:global()` est indispensable ici. Le script du parcours
    reconstruit la liste, et les <li> qu'il crée ne portent pas
    l'identifiant de portée qu'Astro ajoute aux éléments écrits dans ce
    fichier : sans cela, les règles ne les atteignent pas et les
    chevrons disparaissent dès que le fil devient réel.
  */
  .fil-parcours :global(ol) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.15rem 0.55rem;
    font-size: 0.82rem;
    color: color-mix(in oklab, var(--color-paper) 55%, transparent);
  }

  .fil-parcours :global(li) {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  /* Le chevron sépare, il n'annonce pas : posé avant chaque étape sauf
     la première. */
  .fil-parcours :global(li + li)::before {
    content: "›";
    color: color-mix(in oklab, var(--color-paper) 35%, transparent);
  }

  .fil-parcours :global(a) {
    color: var(--color-sage);
    transition: color 180ms ease;
  }

  .fil-parcours :global(a:hover),
  .fil-parcours :global(a:focus-visible) {
    color: var(--color-paper);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .fil-parcours :global([aria-current="page"]) {
    color: color-mix(in oklab, var(--color-paper) 70%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .fil-parcours :global(a) {
      transition: none;
    }
  }
</style>
