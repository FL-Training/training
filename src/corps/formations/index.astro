---
/**
 * Hub « Formations » : les quatre portes de l'architecture V2.
 *
 * PAXI n'y figure pas — consigne de Fabien. Le visiteur y accède depuis
 * l'accueil, la page « Entreprises » ou la page « Organismes de
 * formation », qui portent chacune le contexte de sa demande.
 */
import { getCollection } from "astro:content";
import { nomCollection } from "../../lib/langues";
import Base from "../../layouts/Base.astro";
import Picto from "../../components/Picto.astro";
import { href } from "../../lib/url";
import { contenuLangue } from "../../lib/contenu";
import { langueActive } from "../../lib/langue-active";
import { cheminLangue } from "../../lib/routes";

// La langue se lit dans l'adresse : ce composant sert toutes les
// langues publiées, le contenu suit.
const langue = langueActive(Astro.url.pathname);
const { formationsPage } = contenuLangue(langue);
import { enrichir } from "../../lib/texte";

const portes = (await getCollection(nomCollection("portes", langue) as "portes")).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);
const { seo, entete, portes: intro, carte } = formationsPage;
---

<Base
  title={seo.titre}
  description={seo.description}
  typePage="CollectionPage"
  fil={[{ label: entete.surtitre, chemin: cheminLangue(langue, "/formations") }]}
>
  <section class="mx-auto max-w-6xl px-6 pt-16 pb-20 md:pt-24">
    <p class="eyebrow">{entete.surtitre}</p>
    <h1 class="display mt-4 max-w-3xl text-4xl text-navy-deep md:text-5xl">
      {entete.titre}
    </h1>
    <p
      class="mt-6 max-w-2xl leading-relaxed text-ink-soft"
      set:html={enrichir(entete.texte)}
    />

    <!-- Les quatre portes : par type de visiteur -->
    <div class="mt-14" data-reveal-group data-reveal-stagger="120">
      <h2 class="display text-2xl text-navy-deep md:text-3xl" data-reveal>
        {intro.titre}
      </h2>
      <p class="mt-2 max-w-2xl text-ink-soft" data-reveal>{intro.texte}</p>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {
          portes.map((p) => (
            <a
              href={href(`${cheminLangue(langue, "/formations")}/${p.data.chemin ?? p.id}`)}
              class="card carte-porte flex flex-col overflow-hidden"
              data-reveal
            >
              {p.data.visuel && (
                <div class="carte-visuel" aria-hidden="true">
                  {/*
                    La page doit arriver d'un seul tenant.

                    Les quatre cartes commencent à ~530 px du haut : elles
                    sont dans le premier écran. En `lazy`, le navigateur ne
                    demandait leurs photos qu'après la mise en page ; en
                    `decoding="async"`, il peignait la page sans les
                    attendre. Dans les deux cas on voyait quatre cadres
                    vides se remplir ~70 ms plus tard. Quatre fichiers de
                    30 Ko : les attendre ne coûte rien.
                  */}
                  <img
                    src={href(p.data.visuel.src)}
                    alt=""
                    width="1000"
                    height="1000"
                    loading="eager"
                    decoding="sync"
                  />
                </div>
              )}
              <div class="flex flex-1 flex-col p-7">
                {/*
                  Le pictogramme se lit AVEC le nom de la porte, sur la
                  même ligne : posé au-dessus, il flottait comme une
                  vignette sans rattachement.
                */}
                <h3 class="carte-titre display text-xl leading-snug text-navy-deep">
                  <Picto nom={p.data.picto} />
                  {p.data.nom}
                </h3>
                <p class="mt-2 leading-relaxed text-ink-soft">
                  {p.data.entete.titre}
                </p>
                {p.data.statut === "stub" && (
                  <span class="mt-3 inline-block self-start rounded-full bg-paper-deep/60 px-3 py-1 text-[0.68rem] font-semibold tracking-wide text-ink-faint uppercase">
                    {carte.badge_stub}
                  </span>
                )}
                <span class="mt-auto inline-flex items-center gap-2 pt-5 text-sm font-semibold text-sage-deep">
                  {carte.lien_porte}
                  <span aria-hidden="true">→</span>
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>

    {/*
      Aucun encart PAXI ici : consigne explicite de Fabien, PAXI ne doit
      pas apparaître sur la page principale « Formations ». Ses trois
      points d'accès sont l'accueil, la page « Entreprises » et la page
      « Organismes de formation » — chacune portant le contexte de la
      demande, ce que ce carrefour ne fait pas.
    */}
  </section>
</Base>

<style>
  /*
    Les quatre portes sont le premier choix demandé au visiteur : elles
    doivent accrocher l'œil sans se mettre à clignoter.

    Un seul geste, discret : un liseré vert se trace sur le bord
    supérieur de chaque carte, l'une après l'autre. Il reprend le
    vocabulaire des bordures d'accordéon et des signatures — même
    langage, même retenue. Le pictogramme monte d'un cheveu en même
    temps, ce qui suffit à faire vivre la carte.
  */
  /*
    LE VISUEL DE LA PORTE

    Fabien veut une photographie réelle, mais qui ne prenne pas le pas
    sur le texte. D'où le parti pris : l'image n'a pas de cadre. Ses
    bords ne sont pas adoucis — ils n'existent pas. Un masque en dégradé
    la fait naître au centre et se dissoudre dans le papier de la carte
    sur ses quatre côtés, si bien qu'on ne peut pas dire où elle
    s'arrête.

    Au repos elle est en retrait : peu contrastée, désaturée, discrète.
    Au survol elle revient à la vie — le masque s'ouvre, les couleurs
    reprennent, comme si la situation se précisait à mesure qu'on s'y
    intéresse.
  */
  .carte-visuel {
    position: relative;
    /* Un bandeau large : la photo doit se lire comme une ambiance, pas
       comme une vignette. */
    aspect-ratio: 16 / 8.5;
    overflow: hidden;
  }

  .carte-visuel img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Le fondu : opaque au centre, transparent sur les bords. Les deux
       axes sont traités séparément pour que le haut se dissolve plus
       franchement que les côtés — l'image doit sembler émerger du
       papier, pas y flotter. */
    mask-image:
      linear-gradient(
        to bottom,
        transparent 0%,
        rgb(0 0 0 / 0.55) 18%,
        #000 55%,
        rgb(0 0 0 / 0.35) 88%,
        transparent 100%
      ),
      linear-gradient(
        to right,
        transparent 0%,
        #000 22%,
        #000 78%,
        transparent 100%
      );
    mask-composite: intersect;
    -webkit-mask-composite: source-in;
    opacity: 0.5;
    filter: saturate(0.55) contrast(0.92);
    transform: scale(1.04);
    transition:
      opacity 620ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 620ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 900ms cubic-bezier(0.16, 1, 0.3, 1),
      mask-image 620ms ease;
  }

  .carte-porte:hover .carte-visuel img,
  .carte-porte:focus-visible .carte-visuel img {
    opacity: 0.92;
    filter: saturate(1.05) contrast(1);
    transform: scale(1);
    /* Le masque se resserre sur les bords : l'image se découvre. */
    mask-image:
      linear-gradient(
        to bottom,
        transparent 0%,
        rgb(0 0 0 / 0.8) 8%,
        #000 32%,
        rgb(0 0 0 / 0.72) 94%,
        transparent 100%
      ),
      linear-gradient(
        to right,
        transparent 0%,
        #000 9%,
        #000 91%,
        transparent 100%
      );
  }

  /* Le texte ne doit jamais buter contre l'image : le bas du fondu se
     prolonge derrière lui. */
  .carte-visuel::after {
    content: "";
    position: absolute;
    inset: auto 0 -1px 0;
    height: 2.5rem;
    background: linear-gradient(to bottom, transparent, var(--color-paper));
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .carte-visuel img {
      transition: none;
      transform: none;
    }
  }

  /* Pictogramme et nom sur une même ligne, alignés sur la base du
     texte plutôt que centrés : la toque et le fronton n'ont pas la même
     hauteur visuelle, un centrage les ferait danser d'une carte à
     l'autre. */
  .carte-titre {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .carte-titre :global(svg) {
    flex: none;
    width: 1.35rem;
    height: 1.35rem;
  }

  .carte-porte {
    position: relative;
    overflow: hidden;
  }

  .carte-porte::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(
      90deg,
      var(--color-sage-deep) 0%,
      color-mix(in oklab, var(--color-sage-deep) 35%, transparent) 70%,
      transparent 100%
    );
    transform: scaleX(0);
    transform-origin: left center;
  }

  /*
    Le tracé suit la cascade du groupe : `--reveal-delay` est posé par
    le script de révélation, une valeur par carte. On lui ajoute un
    temps mort pour que le liseré arrive après l'apparition, jamais
    pendant.
  */
  :global(html.js-reveal) .carte-porte:global(.revealed)::before {
    transform: scaleX(1);
    transition: transform 640ms cubic-bezier(0.16, 1, 0.3, 1)
      calc(var(--reveal-delay, 0ms) + 220ms);
  }

  .carte-porte :global(svg) {
    transition: transform 620ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(html.js-reveal) .carte-porte:not(:global(.revealed)) :global(svg) {
    transform: translateY(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .carte-porte::before {
      transform: scaleX(1);
      transition: none;
    }
    .carte-porte :global(svg) {
      transition: none;
      transform: none;
    }
  }
</style>
