---
import { getCollection } from "astro:content";
import { localeLangue, nomCollection } from "../../lib/langues";
import Base from "../../layouts/Base.astro";
import { href } from "../../lib/url";
import { contenuLangue, libelleNavigation } from "../../lib/contenu";
import { langueActive } from "../../lib/langue-active";
import { cheminLangue } from "../../lib/routes";

// La langue se lit dans l'adresse : ce composant sert toutes les
// langues publiées, le contenu suit.
const langue = langueActive(Astro.url.pathname);
const { commun, journalPage } = contenuLangue(langue);
import { tempsDeLecture } from "../../lib/texte";
import { LABELS, nomLabel, ordonnerLabels } from "../../lib/labels";
import { FLUX, descriptionFlux, nomFlux } from "../../lib/flux";
import VisuelFondu from "../../components/VisuelFondu.astro";

const articles = (await getCollection(nomCollection("journal", langue) as "journal")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

// Seuls les labels réellement portés par un article, dans l'ordre de la
// taxonomie : proposer un filtre vide serait une impasse.
const comptesParLabel = new Map<string, number>();
for (const a of articles) {
  for (const id of a.data.labels) {
    comptesParLabel.set(id, (comptesParLabel.get(id) ?? 0) + 1);
  }
}
const labelsPresents = LABELS.filter((l) => comptesParLabel.has(l.id)).map(
  (l) => l.id,
);

/*
  Les quatre flux de l'architecture V2 sont TOUJOURS proposés, même
  ceux qui n'ont pas encore d'article : ce sont les rubriques de la
  ligne éditoriale validée par Fabien, pas une liste déduite du contenu
  publié. N'afficher que les flux utilisés faisait disparaître « Revue
  littéraire » et « Point de vue actu », et donnait à croire que le
  Journal n'avait que deux entrées.

  Ceux qui sont vides sont visuellement en retrait et non cliquables :
  la promesse éditoriale se voit, sans envoyer le lecteur dans une
  liste vide.
*/
const comptesParFlux = new Map<string, number>();
for (const a of articles) {
  comptesParFlux.set(a.data.flux, (comptesParFlux.get(a.data.flux) ?? 0) + 1);
}

const formatDate = new Intl.DateTimeFormat(localeLangue(langue), {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Base
  title={journalPage.seo.titre}
  description={journalPage.seo.description}
  typePage="CollectionPage"
  fil={[{ label: libelleNavigation(langue, "journal"), chemin: cheminLangue(langue, "/journal") }]}
>
  {/*
    L'ENTÊTE, et elle seule, porte le visuel.

    Il tenait toute la page : avec un seul article publié l'équilibre
    fonctionnait, mais la liste va s'allonger et l'image se serait
    étirée sur des rangées de cartes sans plus rien accompagner. Une
    section à part la borne à l'introduction.

    Le sujet a cherché sa forme : un carnet faisait journal intime, une
    étagère seule faisait rangement. C'est une table de lecture en
    bibliothèque — ouvrages ouverts, liseuse posée à côté, rayonnages
    derrière : le fonds documentaire et sa consultation d'aujourd'hui.
  */}
  <section class="relative mx-auto max-w-6xl px-6 pt-16 md:pt-24">
    <VisuelFondu src="/journal/entete.webp" largeur="38%" cadrage="50% 42%" />
    <p class="eyebrow relative">{journalPage.entete.surtitre}</p>
    <h1 class="display relative mt-4 max-w-3xl text-4xl text-navy-deep md:text-5xl">
      {journalPage.entete.titre}
    </h1>
    <p class="relative mt-6 max-w-2xl leading-relaxed text-ink-soft">
      {journalPage.entete.texte}
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-20">

    {/*
      Deux dimensions qui se croisent, et qui ne pèsent pas pareil :

      — le FLUX est la rubrique éditoriale, fixée par l'architecture V2.
        Quatre entrées, stables : c'est une navigation. Elle reprend donc
        le vocabulaire du menu principal — onglets soulignés — et non des
        pastilles.

      — le LABEL est le sujet de l'article. Il y en a davantage, la liste
        grandira, et ce n'est qu'un affinage. Traité en mots légers, sans
        cadre, il s'efface derrière les onglets au lieu de les concurrencer.

      Les deux rangées de gélules identiques, avec deux boutons « Tous »
      côte à côte, mettaient ces deux niveaux sur le même plan et
      saturaient le haut de page.
    */}
    <div class="mt-12" id="filtres-journal">
      <div
        class="flex flex-wrap items-end gap-x-7 gap-y-2 border-b border-ink/10"
        role="group"
        aria-label={journalPage.filtres.filtrer_par_flux}
      >
        <button type="button" data-filtre="tous" class="onglet-flux onglet-actif">
          {journalPage.filtres.tous}
        </button>
        {
          /*
            Les quatre rubriques sont cliquables, y compris celles qui
            n'ont pas encore d'article : le sous-menu du site y mène
            directement, la page doit donc savoir les afficher. Celles
            qui sont vides restent en retrait et annoncent leur état —
            le lecteur voit qu'elles existent sans croire à un défaut.
          */
          FLUX.map((f) => {
            const nombre = comptesParFlux.get(f.id) ?? 0;
            return (
              <button
                type="button"
                data-filtre={f.id}
                title={
                  nombre > 0
                    ? descriptionFlux(f.id, langue)
                    : `${descriptionFlux(f.id, langue)} ${journalPage.filtres.aucun_article_flux}`
                }
                class:list={["onglet-flux", nombre === 0 && "onglet-vide"]}
              >
                {nomFlux(f.id, langue)}
                {nombre === 0 && (
                  <span class="sr-only"> {journalPage.filtres.aucun_article_encore}</span>
                )}
              </button>
            );
          })
        }
      </div>

      {
        labelsPresents.length > 0 && (
          <div class="mt-6">
            {/*
              UN PANNEAU, PAS UNE RANGÉE.

              La taxonomie peut monter à plusieurs dizaines de thèmes.
              Alignés, ils saturaient la page — neuf tenaient déjà de
              justesse sur deux lignes — et l'affinage devenait un mur à
              lire avant de pouvoir choisir.

              Replié, le panneau ne prend qu'une ligne et annonce le
              thème retenu. Ouvert, il donne la liste entière, rangée par
              famille et filtrable au clavier : à quarante entrées, on
              cherche « conflit » plutôt que de parcourir.

              `<details>` natif : l'ouverture et le clavier sont acquis
              sans script, et le panneau reste utilisable si le
              JavaScript ne s'exécute pas — seule la recherche s'en
              passe alors.
            */}
            <details class="panneau-themes" data-panneau-themes>
              <summary>
                <span class="themes-intitule">{journalPage.filtres.labels_titre}</span>
                <span class="themes-choix" data-themes-choix>
                  {journalPage.filtres.tous}
                </span>
                <svg
                  aria-hidden="true"
                  class="themes-chevron"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </summary>

              <div class="themes-corps">
                {/*
                  Le champ n'existe que si le script tourne : sans lui il
                  ne filtrerait rien et promettrait une fonction absente.
                */}
                <input
                  type="search"
                  class="themes-recherche"
                  placeholder={journalPage.filtres.chercher}
                  aria-label={journalPage.filtres.chercher}
                  data-themes-recherche
                  hidden
                />

                <div
                  class="themes-listes"
                  role="group"
                  aria-label={journalPage.filtres.filtrer_par_label}
                >
                  <button type="button" data-label="tous" class="mot-label mot-actif">
                    {journalPage.filtres.tous}
                  </button>

                  {["methode", "champ"].map((groupe) => {
                    const duGroupe = labelsPresents.filter(
                      (id) => LABELS.find((l) => l.id === id)?.groupe === groupe,
                    );
                    return duGroupe.length > 0 ? (
                      <div class="themes-groupe" data-themes-groupe>
                        <p class="themes-groupe-titre">
                          {groupe === "methode"
                            ? journalPage.filtres.groupe_methode
                            : journalPage.filtres.groupe_champ}
                        </p>
                        <div class="themes-puces">
                          {duGroupe.map((id) => (
                            <button
                              type="button"
                              data-label={id}
                              data-nom={nomLabel(id, langue).toLowerCase()}
                              class="mot-label"
                            >
                              {nomLabel(id, langue)}
                              <span class="compte">{comptesParLabel.get(id)}</span>
                            </button>
                          ))}
                        </div>
                      </div>
                    ) : null;
                  })}
                </div>

                <p class="themes-vide" data-themes-vide hidden>
                  {journalPage.filtres.aucun_label}
                </p>
              </div>
            </details>
          </div>
        )
      }
    </div>

    <p
      id="journal-vide"
      class="mt-10 hidden max-w-2xl border-l-2 border-sage/50 pl-6 leading-relaxed text-ink-soft"
    >
      {journalPage.filtres.aucune_selection}
    </p>

    {/*
      DISPOSITION EN BANDES, une par ligne.

      Reprise du parti pris repéré par Fabien sur un site de coaching :
      l'image à gauche, le texte à droite, une carte par ligne. La
      grille à deux colonnes obligeait à comprimer titre et résumé ;
      ici le titre peut respirer sur trois lignes, et la vignette a la
      place d'être lue.

      Elle vaut aussi pour la suite : dix articles s'y empilent sans
      que rien ne se déforme, là où une grille aurait fini par produire
      des rangées inégales.
    */}
    <div class="mt-10 flex flex-col gap-4" data-reveal-group>
      {
        articles.map((article) => (
          <a
            href={href(`${cheminLangue(langue, "/journal")}/${article.data.chemin ?? article.id}`)}
            class="carte-article group"
            data-flux={article.data.flux}
            data-labels={article.data.labels.join(" ")}
            data-reveal
          >
            {/*
              La vignette, quand l'article en a une. Traitement des
              cartes de porte : l'image n'a pas de cadre, ses bords se
              dissolvent dans la carte, et elle s'avive au survol. Une
              carte sans vignette reste correcte — le champ est
              facultatif, et le padding est alors porté par le contenu.
            */}
            {article.data.vignette && (
              <div class="vignette" aria-hidden="true">
                <img
                  src={href(article.data.vignette.src)}
                  alt=""
                  width="1200"
                  height="675"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}
            <div class="carte-corps">
            <div class="flex items-center gap-3 text-xs">
              <span class="rounded-full bg-sage-faint px-3 py-1 font-semibold text-sage-deep">
                {nomFlux(article.data.flux, langue)}
              </span>
              <time
                datetime={article.data.date.toISOString().slice(0, 10)}
                class="text-ink-faint"
              >
                {formatDate.format(article.data.date)}
              </time>
              <span class="text-ink-faint">
                · {tempsDeLecture(article.body ?? "")}&nbsp;
                {commun.journal.duree_lecture}
              </span>
            </div>
            <h2 class="display mt-4 text-2xl leading-snug text-navy-deep md:text-[1.75rem]">
              {article.data.titre}
            </h2>
            <p class="mt-3 max-w-2xl text-[0.98rem] leading-relaxed text-ink-soft">
              {article.data.resume}
            </p>
            {/*
              Même langage que la rangée de filtres : des mots, pas des
              boîtes. Sur une carte déjà dense — rubrique, date, durée,
              titre, résumé — des étiquettes encadrées ajoutaient une
              quatrième forme à lire.
            */}
            {article.data.labels.length > 0 && (
              <ul class="mt-4 flex flex-wrap items-baseline gap-x-3 gap-y-1 text-[0.76rem] text-ink-faint">
                {ordonnerLabels(article.data.labels).map((id) => (
                  <li class="etiquette">{nomLabel(id, langue)}</li>
                ))}
              </ul>
            )}
            <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-sage-deep">
              {commun.journal.lire_article}
              <span
                aria-hidden="true"
                class="transition-transform duration-200 group-hover:translate-x-1"
              >
                →
              </span>
            </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <script>
    /*
      Filtrage sur deux dimensions qui se cumulent. Le label sélectionné
      est reflété dans l'URL (`?label=…`) : n'importe quelle page du
      site peut donc pointer vers le Journal déjà filtré, et le lien
      reste partageable. La navigation par l'historique est prise en
      charge, sans quoi le bouton « précédent » laisserait des filtres
      actifs sur une liste qui ne leur correspond plus.
    */
    function initFiltres() {
      const filtres = document.querySelector("#filtres-journal");
      if (!filtres) return;

      const boutonsFlux =
        document.querySelectorAll<HTMLButtonElement>(".onglet-flux");
      const boutonsLabel =
        document.querySelectorAll<HTMLButtonElement>(".mot-label");
      const cartes = document.querySelectorAll<HTMLElement>("[data-flux]");
      const vide = document.querySelector<HTMLElement>("#journal-vide");

      let flux = "tous";
      let label = "tous";

      const activer = (
        boutons: NodeListOf<HTMLButtonElement>,
        attribut: "filtre" | "label",
        valeur: string,
      ) => {
        boutons.forEach((b) => {
          const actif = b.dataset[attribut] === valeur;
          b.classList.toggle(attribut === "filtre" ? "onglet-actif" : "mot-actif", actif);
          b.setAttribute("aria-pressed", String(actif));
        });
      };

      /*
        Le mouvement est une aide à la lecture, pas un ornement : qui a
        demandé moins d'animation reçoit le même filtrage, sans fondu.
      */
      const sobre = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      let premierRendu = true;

      const appliquer = () => {
        let visibles = 0;
        cartes.forEach((carte) => {
          const labels = (carte.dataset.labels ?? "").split(" ");
          const garde =
            (flux === "tous" || carte.dataset.flux === flux) &&
            (label === "tous" || labels.includes(label));
          const etaitCachee = carte.style.display === "none";
          carte.style.display = garde ? "" : "none";
          if (garde) {
            /*
              N'animer que ce qui ARRIVE, et jamais au premier rendu —
              la page ne doit pas se reconstruire sous les yeux de
              quelqu'un qui n'a rien demandé.
            */
            if (!sobre && !premierRendu && etaitCachee) {
              carte.style.setProperty("--retard-carte", `${Math.min(visibles, 5) * 45}ms`);
              carte.classList.remove("carte-arrive");
              // Forcer le navigateur à reprendre l'animation depuis son
              // début : sans cette lecture, retirer puis remettre la
              // classe dans le même souffle ne relance rien.
              void carte.offsetWidth;
              carte.classList.add("carte-arrive");
            }
            visibles++;
          }
        });
        premierRendu = false;
        vide?.classList.toggle("hidden", visibles > 0);
        activer(boutonsFlux, "filtre", flux);
        activer(boutonsLabel, "label", label);
        refleterChoix();
      };

      /*
        Le thème retenu s'affiche sur le panneau replié : sans cela, il
        faudrait l'ouvrir pour savoir ce qui filtre la page.
      */
      const panneau = document.querySelector<HTMLDetailsElement>("[data-panneau-themes]");
      const choix = document.querySelector<HTMLElement>("[data-themes-choix]");
      const refleterChoix = () => {
        if (!choix) return;
        const actif = document.querySelector<HTMLButtonElement>(
          `[data-label="${label}"]`,
        );
        choix.textContent = actif?.childNodes[0]?.textContent?.trim() ?? label;
      };

      /*
        La recherche de thème. Révélée seulement ici : sans script elle
        ne filtrerait rien, et un champ qui ne répond pas est pire que
        pas de champ du tout.

        Elle masque les puces qui ne correspondent pas, puis les familles
        devenues vides — sinon un titre de groupe resterait seul.
      */
      const recherche = document.querySelector<HTMLInputElement>("[data-themes-recherche]");
      const rienTrouve = document.querySelector<HTMLElement>("[data-themes-vide]");
      if (recherche) {
        recherche.hidden = false;
        recherche.addEventListener("input", () => {
          const q = recherche.value.trim().toLowerCase();
          let trouves = 0;
          for (const b of boutonsLabel) {
            if (b.dataset.label === "tous") continue;
            const garde = !q || (b.dataset.nom ?? "").includes(q);
            b.hidden = !garde;
            if (garde) trouves++;
          }
          for (const g of document.querySelectorAll<HTMLElement>("[data-themes-groupe]")) {
            g.hidden = !g.querySelector<HTMLElement>(".mot-label:not([hidden])");
          }
          rienTrouve && (rienTrouve.hidden = trouves > 0);
        });
      }

      /*
        Choisir un thème referme le panneau : la liste a fait son office,
        et la page filtrée doit redevenir visible. Le focus revient au
        bouton, sans quoi il tomberait sur un élément qu'on vient de
        replier.
      */
      boutonsLabel.forEach((b) =>
        b.addEventListener("click", () => {
          if (!panneau?.open) return;
          panneau.open = false;
          panneau.querySelector("summary")?.focus();
        }),
      );

      // Les deux filtres se lisent dans l'URL : le menu du site et
      // n'importe quel lien peuvent donc ouvrir le Journal sur une
      // rubrique ou un thème précis, et l'adresse reste partageable.
      const lireUrl = () => {
        const params = new URL(window.location.href).searchParams;
        const fluxDemande = params.get("flux");
        const labelDemande = params.get("label");
        const connu = (
          boutons: NodeListOf<HTMLButtonElement>,
          cle: "filtre" | "label",
          valeur: string,
        ) =>
          [...boutons].some((b) => b.dataset[cle] === valeur);

        flux =
          fluxDemande && connu(boutonsFlux, "filtre", fluxDemande)
            ? fluxDemande
            : "tous";
        label =
          labelDemande && connu(boutonsLabel, "label", labelDemande)
            ? labelDemande
            : "tous";
        appliquer();
      };

      const ecrireUrl = () => {
        const url = new URL(window.location.href);
        for (const [cle, valeur] of [
          ["flux", flux],
          ["label", label],
        ]) {
          if (valeur === "tous") url.searchParams.delete(cle);
          else url.searchParams.set(cle, valeur);
        }
        history.replaceState({}, "", url);
      };

      boutonsFlux.forEach((bouton) =>
        bouton.addEventListener("click", () => {
          flux = bouton.dataset.filtre ?? "tous";
          appliquer();
          ecrireUrl();
        }),
      );

      boutonsLabel.forEach((bouton) =>
        bouton.addEventListener("click", () => {
          label = bouton.dataset.label ?? "tous";
          appliquer();
          ecrireUrl();
        }),
      );

      window.addEventListener("popstate", lireUrl);
      lireUrl();
    }
    document.addEventListener("astro:page-load", initFiltres);
  </script>
</Base>

<style>
  /*
    LA CARTE D'ARTICLE, EN BANDE.

    Image à gauche, texte à droite, une par ligne. Ni ombre ni carte
    posée : un filet discret au-dessus, comme les séparations
    éditoriales du site, et un fond qui se teinte à peine au survol.
    Le geste reste celui du papier, pas celui d'une interface.

    Sans vignette, la bande n'a qu'une colonne : le texte prend toute
    la largeur, la mise en page ne s'effondre pas.
  */
  .carte-article {
    display: grid;
    gap: 0;
    border-top: 1px solid color-mix(in oklab, var(--color-ink) 10%, transparent);
    transition: background-color 260ms ease;
  }

  .carte-article:hover,
  .carte-article:focus-visible {
    background: color-mix(in oklab, var(--color-paper-deep) 18%, transparent);
  }

  .carte-corps {
    display: flex;
    flex-direction: column;
    padding: 1.75rem 0 2.25rem;
  }

  @media (min-width: 768px) {
    .carte-article:has(.vignette) {
      grid-template-columns: 21rem 1fr;
      gap: 2.5rem;
      align-items: center;
    }

    .carte-corps {
      padding: 2.25rem 1.5rem 2.25rem 0;
    }
  }

  @media (min-width: 1280px) {
    .carte-article:has(.vignette) {
      grid-template-columns: 25rem 1fr;
      gap: 3rem;
    }
  }

  /*
    LA VIGNETTE.

    Même traitement que les visuels de porte : pas de cadre, des bords
    qui se dissolvent, une image en retrait qui reprend ses couleurs
    quand on s'y intéresse.
  */
  .vignette {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .vignette img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.62;
    filter: saturate(0.6) contrast(0.94);
    transform: scale(1.03);
    mask-image: radial-gradient(
      ellipse 66% 66% at 50% 50%,
      #000 0%,
      rgb(0 0 0 / 0.9) 46%,
      rgb(0 0 0 / 0.5) 72%,
      transparent 94%
    );
    transition:
      opacity 520ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 520ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 760ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .carte-article:hover .vignette img,
  .carte-article:focus-visible .vignette img {
    opacity: 0.95;
    filter: saturate(1.02) contrast(1);
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .carte-article,
    .vignette img {
      transition: none;
    }
  }

  /*
    FLUX — la rubrique éditoriale. Même geste que le menu principal :
    un mot, un filet vert dessous quand il est actif. Aucune gélule, pour
    que cette rangée se lise comme une navigation et non comme une
    collection d'étiquettes.
  */
  .onglet-flux {
    /* Au doigt, un onglet de 37 px se manque : sur petit écran, on lui
       donne la hauteur d'une vraie cible sans déplacer son filet, qui
       reste calé sur le bas de la boîte. */
    display: inline-flex;
    align-items: flex-end;
    min-height: 2.75rem;
    padding-bottom: 0.65rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-ink-soft);
    border-bottom: 2px solid transparent;
    /* Le filet part du centre : le mot ne bouge pas d'un pixel quand il
       devient actif. */
    background-image: linear-gradient(
      var(--color-sage-deep),
      var(--color-sage-deep)
    );
    background-repeat: no-repeat;
    background-position: 50% 100%;
    background-size: 0% 2px;
    transition:
      color 220ms ease,
      background-size 340ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .onglet-flux:hover:not(.onglet-vide) {
    color: var(--color-navy-deep);
    background-size: 40% 2px;
  }

  .onglet-flux.onglet-actif {
