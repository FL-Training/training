# Public URL of the independently isolated self-hosted Convex backend.
# Local development may override it with an anonymous local deployment.
PUBLIC_CONVEX_URL=https://site-convex-dev.app.pacivisacademy.com

# Public site URL used to produce canonical links.
PUBLIC_SITE_URL=https://dev.app.pacivisacademy.com

# Sveltia CMS edits the reviewed Git branch through the Pacivis OAuth proxy.
SVELTIA_BRANCH=main
SVELTIA_CLIENT_OAUTH=https://oauth.app.pacivisacademy.com

# --- Référencement : vérification de propriété (facultatif) ---------------
# Le contenu de la balise fournie par Google Search Console ou Bing
# Webmaster Tools, quand on ne peut pas vérifier par DNS. Laisser vide :
# aucune balise n'est alors écrite dans les pages.
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
