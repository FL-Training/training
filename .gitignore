# build output
dist/
.astro/
.vercel/

# dependencies
node_modules/

# environment
.env
.env.*
!.env.example

# Convex
.convex/
convex/_generated/

# IDE / OS
.idea/
.vscode/
.DS_Store

# Outillage local de l'assistant. Seul `launch.json` est visé : il ne
# décrit qu'un confort de démarrage sur la machine où l'on travaille.
# Le reste de .claude/ n'est pas ignoré — des réglages ou des consignes
# de projet y auraient leur place et mériteraient d'être partagés.
.claude/launch.json

# logs
npm-debug.log*

# Images de partage des articles : produites par `npm run build`
# (outils/generer-partages-articles.mjs) à partir des illustrations.
# Les versionner les ferait diverger de leur source à la première
# modification faite depuis Sveltia.
public/journal/vignettes/**/*-partage.jpg
