{
  "name": "pacivis-academy-site",
  "version": "0.1.0",
  "description": "Site vitrine de Pacivis Academy — Fabien Lacombe, formation à la prévention et à la gestion des conflits",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run og:articles && astro build",
    "check": "astro check",
    "preview": "astro preview",
    "apercu": "astro build && astro preview",
    "astro": "astro",
    "test:styles": "node tests/styles-navigation.mjs",
    "test:cms": "node tests/cms-schemas.mjs",
    "cms:config": "node outils/generer-config-sveltia.mjs",
    "test:unitaires": "node --test tests/unitaires/*.test.mjs",
    "i18n:etat": "node outils/etat-traduction.mjs",
    "audit:seo": "node outils/audit-seo.mjs",
    "audit:a11y": "node outils/audit-accessibilite.mjs",
    "test": "npm run check && npm run build && npm run test:cms && npm run test:unitaires && npm run test:styles && npm run audit:seo && npm run audit:a11y",
    "og:image": "node outils/generer-og-image.mjs",
    "og:articles": "node outils/generer-partages-articles.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.0.2",
    "@astrojs/react": "^6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/archivo": "^5.2.8",
    "@fontsource/marcellus": "^5.3.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "astro": "7.1.3",
    "convex": "1.42.1",
    "lenis": "^1.3.25",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@emnapi/core": "^1.11.2",
    "@emnapi/runtime": "^1.11.2",
    "@rollup/plugin-yaml": "^5.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "axe-core": "^4.12.1",
    "lucide-static": "^1.24.0",
    "playwright-core": "^1.62.0",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18"
  }
}
